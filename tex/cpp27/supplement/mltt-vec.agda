-- ─── the derived operations ─────────────────────────────────────────
-- Neither is primitive and neither has rules of its own: weakening is a
-- renaming, single substitution is a cons onto the identity.  The
-- rewrite system computes through both without knowing they exist.

weaken : S ⊢ s → (s′ ∷ S) ⊢ s
weaken t = t [ wkᴿ _ ]ᴿ

_[_]₀ : (s′ ∷ S) ⊢ s → S ⊢ s′ → S ⊢ s
t [ t′ ]₀ = t [ (t′ ∙ˢ idˢ) ]ˢ

-- ═══ SYNTAX OF REDUCTION, CONVERSION AND TYPING ═══════════════════════════════════════════

-- Martin-Löf type theory on top of the generated σ-calculus core.
--
-- PRESENTATION:
--   * ONE syntactic sort.  Types ARE terms.
--   * Extrinsic (Curry/PTS) typing:  Γ ⊢ t ∶ A  with A : S ⊢ tm.
--   * Definitional equality is UNTYPED conversion _≡β_, the
--     reflexive-symmetric-transitive closure of the compatible
--     one-step reduction _↪_ on raw terms (Barendregt/PTS style).
--   * Type : Type.  Logically inconsistent (Girard) but type-SAFE.



-- ─── contexts: the framework's telescopes, verbatim from systemf.agda ─

↑ˢᵗ_ : Sort → Sort
↑ˢᵗ tm = tm

_∶⊢_ : Scope → Sort → Set
S ∶⊢ s = S ⊢ (↑ˢᵗ s)

depth : S ∋ s → ℕ
depth zero    = zero
depth (suc x) = suc (depth x)

drop-∈ : S ∋ s → Scope → Scope
drop-∈ x S = drop (suc (depth x)) S

Ctx : Scope → Set
Ctx S = ∀ s → (x : S ∋ s) → drop-∈ x S ∶⊢ s

_∷ₜ_ : S ∶⊢ s → Ctx S → Ctx (s ∷ S)
(t ∷ₜ Γ) _ zero    = t
(t ∷ₜ Γ) _ (suc x) = Γ _ x

wk-drop-∈ : (x : S ∋ s) → drop-∈ x S ⊢ s′ → S ⊢ s′
wk-drop-∈ zero    t = weaken t
wk-drop-∈ (suc x) t = weaken (wk-drop-∈ x t)

wk-telescope : Ctx S → S ∋ s → S ∶⊢ s
wk-telescope Γ x = wk-drop-∈ x (Γ _ x)

_∋_∶_ : Ctx S → S ∋ s → S ∶⊢ s → Set
Γ ∋ x ∶ t = wk-telescope Γ x ≡ t

variable
  Γ Γ₁ Γ₂ : Ctx S
  A B A′ B′ P z sc n f a b : S ⊢ tm

-- ─── the successor-branch motive ────────────────────────────────────
-- P lives over (Nat ∷ S).  The successor branch is checked in
-- (P ∷ Nat ∷ S) at "P (suc n)": P with its variable set to
-- sucN (var zero), then weakened past the induction hypothesis.

sucMotive : (tm ∷ S) ⊢ tm → (tm ∷ tm ∷ S) ⊢ tm
sucMotive P = weaken (P [ sucN (var zero) ∙ˢ wkˢ tm ]ˢ)

-- ─── one-step reduction on RAW terms (β and ι, full congruence) ─────

data _↪_ : S ⊢ tm → S ⊢ tm → Set where
  β-app   : app (lam A b) a ↪ (b [ a ]₀)
  ι-zero  : natrec P z sc zeroN ↪ z
  ι-suc   : natrec P z sc (sucN n) ↪ (sc [ natrec P z sc n ∙ˢ (n ∙ˢ idˢ) ]ˢ)

  ξ-Pi₁     : A ↪ A′ → Pi A B ↪ Pi A′ B
  ξ-Pi₂     : B ↪ B′ → Pi A B ↪ Pi A B′
  ξ-lam₁    : A ↪ A′ → lam A b ↪ lam A′ b
  ξ-lam₂    : b ↪ B′ → lam A b ↪ lam A B′
  ξ-app₁    : f ↪ A′ → app f a ↪ app A′ a
  ξ-app₂    : a ↪ A′ → app f a ↪ app f A′
  ξ-sucN    : n ↪ A′ → sucN n ↪ sucN A′
  ξ-natrec₁ : P ↪ A′ → natrec P z sc n ↪ natrec A′ z sc n
  ξ-natrec₂ : z ↪ A′ → natrec P z sc n ↪ natrec P A′ sc n
  ξ-natrec₃ : sc ↪ B′ → natrec P z sc n ↪ natrec P z B′ n
  ξ-natrec₄ : n ↪ A′ → natrec P z sc n ↪ natrec P z sc A′

-- ─── untyped conversion: the definitional equality of types ─────────

data _≡β_ : S ⊢ tm → S ⊢ tm → Set where
  β-refl  : A ≡β A
  β-step  : A ↪ B → A ≡β B
  β-sym   : A ≡β B → B ≡β A
  β-trans : A ≡β B → B ≡β A′ → A ≡β A′

-- ─── the typing judgment ────────────────────────────────────────────

data _⊢_∶_ : Ctx S → S ⊢ tm → S ⊢ tm → Set where
  ⊢var : ∀ {x : S ∋ tm} →
    Γ ∋ x ∶ A →
    Γ ⊢ (var x) ∶ A

  ⊢U : Γ ⊢ U ∶ U

  ⊢Pi :
    Γ ⊢ A ∶ U →
    (A ∷ₜ Γ) ⊢ B ∶ U →
    Γ ⊢ (Pi A B) ∶ U

  ⊢lam :
    Γ ⊢ A ∶ U →
    (A ∷ₜ Γ) ⊢ b ∶ B →
    Γ ⊢ (lam A b) ∶ (Pi A B)

  ⊢app :
    Γ ⊢ f ∶ (Pi A B) →
    Γ ⊢ a ∶ A →
    Γ ⊢ (app f a) ∶ (B [ a ]₀)

  ⊢Nat : Γ ⊢ Nat ∶ U

  ⊢zeroN : Γ ⊢ zeroN ∶ Nat

  ⊢sucN :
    Γ ⊢ n ∶ Nat →
    Γ ⊢ (sucN n) ∶ Nat

  ⊢natrec :
    (Nat ∷ₜ Γ) ⊢ P ∶ U →
    Γ ⊢ z ∶ (P [ zeroN ]₀) →
    (P ∷ₜ (Nat ∷ₜ Γ)) ⊢ sc ∶ (sucMotive P) →
    Γ ⊢ n ∶ Nat →
    Γ ⊢ (natrec P z sc n) ∶ (P [ n ]₀)

  -- NOTE.  The well-formedness premise `Γ ⊢ B ∶ U` is deliberately
  -- OMITTED.  Keeping it would force the validity ("type correctness")
  -- lemma  Γ ⊢ t ∶ A → Γ ⊢ A ∶ U,  whose ⊢var case needs a separate
  -- context-well-formedness judgment.  That machinery is orthogonal to
  -- the substitution question this experiment measures.  The cost is
  -- that the system admits Γ ⊢ t ∶ B for some ill-formed B; it does not
  -- affect preservation, progress, or any substitution count.
  ⊢conv :
    Γ ⊢ a ∶ A →
    A ≡β B →
    Γ ⊢ a ∶ B

-- ═══ CONSEQUENCES OF CHURCH-ROSSER ═══════════════════════════════════════════

-- Consequences of Church-Rosser for the untyped calculus.
--
-- Church-Rosser for the untyped calculus, PROVED below by Takahashi's
-- method.  Everything in this section is
-- PROVED from it.  CR is the Takahashi/parallel-reduction theorem for
-- the untyped β/ι calculus; it has nothing to do with the substitution
-- framework, which is why it is assumed rather than proved.



-- multi-step reduction
data _↠_ : S ⊢ tm → S ⊢ tm → Set where
  ↠-refl : A ↠ A
  ↠-step : A ↪ B → B ↠ A′ → A ↠ A′

↠→≡β : ∀ {S} {A B : S ⊢ tm} → A ↠ B → A ≡β B
↠→≡β ↠-refl        = β-refl
↠→≡β (↠-step r rs) = β-trans (β-step r) (↠→≡β rs)

-- ════════════════════════════════════════════════════════════════════
-- CHURCH-ROSSER, PROVED.  Takahashi's method of complete developments.
--
-- No postulate, no hole, no TERMINATING pragma.  The only substitution
-- fact the proof needs is that parallel reduction is stable under
-- substitutions that agree pointwise up to ⇛; every equation that this
-- raises -- including the β-redex law and the TWO-VARIABLE ι-suc law --
-- is already one of the 89 rewrite rules, so each of them closes by
-- `refl` and none of them is stated by hand.
-- ════════════════════════════════════════════════════════════════════

variable
  P′ z′ sc′ n′ f′ a′ b′ : S ⊢ tm

-- ─── 1.  parallel reduction ─────────────────────────────────────────
-- One constructor per term former, plus one per redex form.

infix 3 _⇛_

data _⇛_ : S ⊢ tm → S ⊢ tm → Set where
  ⇛-var    : ∀ {S} {x : S ∋ tm} → var x ⇛ var x
  ⇛-U      : U {S = S} ⇛ U
  ⇛-Nat    : Nat {S = S} ⇛ Nat
  ⇛-zeroN  : zeroN {S = S} ⇛ zeroN
  ⇛-Pi     : A ⇛ A′ → B ⇛ B′ → Pi A B ⇛ Pi A′ B′
  ⇛-lam    : A ⇛ A′ → b ⇛ b′ → lam A b ⇛ lam A′ b′
  ⇛-app    : f ⇛ f′ → a ⇛ a′ → app f a ⇛ app f′ a′
  ⇛-sucN   : n ⇛ n′ → sucN n ⇛ sucN n′
  ⇛-natrec : P ⇛ P′ → z ⇛ z′ → sc ⇛ sc′ → n ⇛ n′ →
             natrec P z sc n ⇛ natrec P′ z′ sc′ n′
  ⇛-beta   : b ⇛ b′ → a ⇛ a′ → app (lam A b) a ⇛ (b′ [ a′ ]₀)
  ⇛-ιzero  : z ⇛ z′ → natrec P z sc zeroN ⇛ z′
  ⇛-ιsuc   : P ⇛ P′ → z ⇛ z′ → sc ⇛ sc′ → n ⇛ n′ →
             natrec P z sc (sucN n) ⇛
             (sc′ [ natrec P′ z′ sc′ n′ ∙ˢ (n′ ∙ˢ idˢ) ]ˢ)

⇛-refl : ∀ {S} (t : S ⊢ tm) → t ⇛ t
⇛-refl (var x)             = ⇛-var
⇛-refl U                   = ⇛-U
⇛-refl Nat                 = ⇛-Nat
⇛-refl zeroN               = ⇛-zeroN
⇛-refl (Pi A B)            = ⇛-Pi (⇛-refl A) (⇛-refl B)
⇛-refl (lam A b)           = ⇛-lam (⇛-refl A) (⇛-refl b)
⇛-refl (app f a)           = ⇛-app (⇛-refl f) (⇛-refl a)
⇛-refl (sucN n)            = ⇛-sucN (⇛-refl n)
⇛-refl (natrec P z sc n)   = ⇛-natrec (⇛-refl P) (⇛-refl z) (⇛-refl sc) (⇛-refl n)

-- ─── 2.  ⇛ is stable under renaming ─────────────────────────────────
-- The three redex cases PIN the constructor's implicits, exactly as
-- `↪-sub` does above: the two-world rule set has already rewritten the
-- goal's index, so Agda can no longer read the arguments back off it.
-- Once pinned every case closes by the constructor alone -- the β law
-- and the two-variable ι-suc law are both definitional.

⇛-ren : ∀ {S₁ S₂} {t t′ : S₁ ⊢ tm} {ξ : S₁ →ᴿ S₂} →
  t ⇛ t′ → (t [ ξ ]ᴿ) ⇛ (t′ [ ξ ]ᴿ)
⇛-ren ⇛-var   = ⇛-var
⇛-ren ⇛-U     = ⇛-U
⇛-ren ⇛-Nat   = ⇛-Nat
⇛-ren ⇛-zeroN = ⇛-zeroN
⇛-ren {ξ = ξ} (⇛-Pi p q)  = ⇛-Pi  (⇛-ren {ξ = ξ} p) (⇛-ren {ξ = ξ ↑ᴿ tm} q)
⇛-ren {ξ = ξ} (⇛-lam p q) = ⇛-lam (⇛-ren {ξ = ξ} p) (⇛-ren {ξ = ξ ↑ᴿ tm} q)
⇛-ren {ξ = ξ} (⇛-app p q) = ⇛-app (⇛-ren {ξ = ξ} p) (⇛-ren {ξ = ξ} q)
⇛-ren {ξ = ξ} (⇛-sucN p)  = ⇛-sucN (⇛-ren {ξ = ξ} p)
⇛-ren {ξ = ξ} (⇛-natrec p q r s) =
  ⇛-natrec (⇛-ren {ξ = ξ ↑ᴿ tm} p) (⇛-ren {ξ = ξ} q)
           (⇛-ren {ξ = (ξ ↑ᴿ tm) ↑ᴿ tm} r) (⇛-ren {ξ = ξ} s)
-- definitional: (b′ [ a′ ]₀) [ ξ ]ᴿ ≡ (b′ [ ξ ↑ᴿ tm ]ᴿ) [ a′ [ ξ ]ᴿ ]₀
⇛-ren {ξ = ξ} (⇛-beta {b = b} {b′ = b′} {a = a} {a′ = a′} {A = A} p q) =
  ⇛-beta {b = b [ ξ ↑ᴿ tm ]ᴿ} {b′ = b′ [ ξ ↑ᴿ tm ]ᴿ}
         {a = a [ ξ ]ᴿ} {a′ = a′ [ ξ ]ᴿ} {A = A [ ξ ]ᴿ}
         (⇛-ren {ξ = ξ ↑ᴿ tm} p) (⇛-ren {ξ = ξ} q)
⇛-ren {ξ = ξ} (⇛-ιzero {z′ = z′} {P = P} {sc = sc} p) =
  ⇛-ιzero {z′ = z′ [ ξ ]ᴿ} {P = P [ ξ ↑ᴿ tm ]ᴿ} {sc = sc [ (ξ ↑ᴿ tm) ↑ᴿ tm ]ᴿ}
          (⇛-ren {ξ = ξ} p)
-- definitional: the two-variable ι-suc law under a renaming
⇛-ren {ξ = ξ} (⇛-ιsuc {P = P} {P′ = P′} {z = z} {z′ = z′}
                      {sc = sc} {sc′ = sc′} {n = n} {n′ = n′} p q r s) =
  ⇛-ιsuc {P = P [ ξ ↑ᴿ tm ]ᴿ} {P′ = P′ [ ξ ↑ᴿ tm ]ᴿ}
         {z = z [ ξ ]ᴿ} {z′ = z′ [ ξ ]ᴿ}
         {sc = sc [ (ξ ↑ᴿ tm) ↑ᴿ tm ]ᴿ} {sc′ = sc′ [ (ξ ↑ᴿ tm) ↑ᴿ tm ]ᴿ}
         {n = n [ ξ ]ᴿ} {n′ = n′ [ ξ ]ᴿ}
         (⇛-ren {ξ = ξ ↑ᴿ tm} p) (⇛-ren {ξ = ξ} q)
         (⇛-ren {ξ = (ξ ↑ᴿ tm) ↑ᴿ tm} r) (⇛-ren {ξ = ξ} s)

-- ─── 3.  pointwise lifting of ⇛ to substitutions ────────────────────

-- A RECORD, not a Π-type: σ and σ′ occur in the field's type only
-- under `_[_]ˢ`, so as a bare function type they would never be
-- solvable by unification.  As record parameters they are.

record _⇛ˢ_ {S₁ S₂ : Scope} (σ σ′ : S₁ →ˢ S₂) : Set where
  constructor ⇛ˢ⟨_⟩
  field ⇛ˢ-at : ∀ (x : S₁ ∋ tm) → (x [ σ ]ˢ) ⇛ (x [ σ′ ]ˢ)
open _⇛ˢ_

-- definitional: at `zero` both sides are `var zero` (def-↑ˢ-zero); at
-- `suc x` the goal is `x [ σ ⨟ ⟨ wkᴿ tm ⟩ ]ˢ ⇛ …` (def-↑ˢ-suc), which
-- is what ⇛-ren at wkᴿ delivers after compositionalityˢᴿ.  No lemma.
⇛ˢ-↑ : ∀ {S₁ S₂} {σ σ′ : S₁ →ˢ S₂} → σ ⇛ˢ σ′ → (σ ↑ˢ tm) ⇛ˢ (σ′ ↑ˢ tm)
⇛ˢ-↑ p = ⇛ˢ⟨ (λ where
  zero    → ⇛-var
  (suc x) → ⇛-ren {ξ = wkᴿ tm} (⇛ˢ-at p x)) ⟩

-- definitional: def-∙ˢ-zero and def-∙ˢ-suc
⇛ˢ-∙ : ∀ {S₁ S₂} {t t′ : S₂ ⊢ tm} {σ σ′ : S₁ →ˢ S₂} →
  t ⇛ t′ → σ ⇛ˢ σ′ → (t ∙ˢ σ) ⇛ˢ (t′ ∙ˢ σ′)
⇛ˢ-∙ p q = ⇛ˢ⟨ (λ where
  zero    → p
  (suc x) → ⇛ˢ-at q x) ⟩

-- definitional: coincidence-var then right-idᴿ turn `x [ idˢ ]ˢ` into `var x`
⇛ˢ-id : ∀ {S} → idˢ {S} ⇛ˢ idˢ
⇛ˢ-id = ⇛ˢ⟨ (λ x → ⇛-var) ⟩

-- ─── 4.  the substitution lemma for ⇛ ───────────────────────────────

⇛-sub : ∀ {S₁ S₂} {t t′ : S₁ ⊢ tm} {σ σ′ : S₁ →ˢ S₂} →
  t ⇛ t′ → σ ⇛ˢ σ′ → (t [ σ ]ˢ) ⇛ (t′ [ σ′ ]ˢ)
⇛-sub (⇛-var {x = x}) pσ = ⇛ˢ-at pσ x
⇛-sub ⇛-U     pσ = ⇛-U
⇛-sub ⇛-Nat   pσ = ⇛-Nat
⇛-sub ⇛-zeroN pσ = ⇛-zeroN
⇛-sub {σ = σ} {σ′ = σ′} (⇛-Pi p q) pσ =
  ⇛-Pi (⇛-sub {σ = σ} {σ′ = σ′} p pσ)
       (⇛-sub {σ = σ ↑ˢ tm} {σ′ = σ′ ↑ˢ tm} q (⇛ˢ-↑ pσ))
⇛-sub {σ = σ} {σ′ = σ′} (⇛-lam p q) pσ =
  ⇛-lam (⇛-sub {σ = σ} {σ′ = σ′} p pσ)
        (⇛-sub {σ = σ ↑ˢ tm} {σ′ = σ′ ↑ˢ tm} q (⇛ˢ-↑ pσ))
⇛-sub {σ = σ} {σ′ = σ′} (⇛-app p q) pσ =
  ⇛-app (⇛-sub {σ = σ} {σ′ = σ′} p pσ) (⇛-sub {σ = σ} {σ′ = σ′} q pσ)
⇛-sub {σ = σ} {σ′ = σ′} (⇛-sucN p) pσ = ⇛-sucN (⇛-sub {σ = σ} {σ′ = σ′} p pσ)
⇛-sub {σ = σ} {σ′ = σ′} (⇛-natrec p q r s) pσ =
  ⇛-natrec (⇛-sub {σ = σ ↑ˢ tm} {σ′ = σ′ ↑ˢ tm} p (⇛ˢ-↑ pσ))
           (⇛-sub {σ = σ} {σ′ = σ′} q pσ)
           (⇛-sub {σ = (σ ↑ˢ tm) ↑ˢ tm} {σ′ = (σ′ ↑ˢ tm) ↑ˢ tm} r (⇛ˢ-↑ (⇛ˢ-↑ pσ)))
           (⇛-sub {σ = σ} {σ′ = σ′} s pσ)
-- definitional: (b′ [ a′ ]₀) [ σ′ ]ˢ ≡ (b′ [ σ′ ↑ˢ tm ]ˢ) [ a′ [ σ′ ]ˢ ]₀
⇛-sub {σ = σ} {σ′ = σ′} (⇛-beta {b = b} {b′ = b′} {a = a} {a′ = a′} {A = A} p q) pσ =
  ⇛-beta {b = b [ σ ↑ˢ tm ]ˢ} {b′ = b′ [ σ′ ↑ˢ tm ]ˢ}
         {a = a [ σ ]ˢ} {a′ = a′ [ σ′ ]ˢ} {A = A [ σ ]ˢ}
         (⇛-sub {σ = σ ↑ˢ tm} {σ′ = σ′ ↑ˢ tm} p (⇛ˢ-↑ pσ))
         (⇛-sub {σ = σ} {σ′ = σ′} q pσ)
⇛-sub {σ = σ} {σ′ = σ′} (⇛-ιzero {z′ = z′} {P = P} {sc = sc} p) pσ =
  ⇛-ιzero {z′ = z′ [ σ′ ]ˢ} {P = P [ σ ↑ˢ tm ]ˢ} {sc = sc [ (σ ↑ˢ tm) ↑ˢ tm ]ˢ}
          (⇛-sub {σ = σ} {σ′ = σ′} p pσ)
-- definitional: the TWO-VARIABLE ι-suc law commuting with σ.  The RHS
-- of ⇛-ιsuc is a substitution by a two-element cons; pushing σ′ through
-- it is `dist` twice followed by `comp-idₗ`, and pulling the double
-- lift out of sc′ is `lift-cons` twice.  Both sides land on the same
-- normal form, so the constructor alone closes the case.
⇛-sub {σ = σ} {σ′ = σ′} (⇛-ιsuc {P = P} {P′ = P′} {z = z} {z′ = z′}
                                {sc = sc} {sc′ = sc′} {n = n} {n′ = n′} p q r s) pσ =
  ⇛-ιsuc {P = P [ σ ↑ˢ tm ]ˢ} {P′ = P′ [ σ′ ↑ˢ tm ]ˢ}
         {z = z [ σ ]ˢ} {z′ = z′ [ σ′ ]ˢ}
         {sc = sc [ (σ ↑ˢ tm) ↑ˢ tm ]ˢ} {sc′ = sc′ [ (σ′ ↑ˢ tm) ↑ˢ tm ]ˢ}
         {n = n [ σ ]ˢ} {n′ = n′ [ σ′ ]ˢ}
         (⇛-sub {σ = σ ↑ˢ tm} {σ′ = σ′ ↑ˢ tm} p (⇛ˢ-↑ pσ))
         (⇛-sub {σ = σ} {σ′ = σ′} q pσ)
         (⇛-sub {σ = (σ ↑ˢ tm) ↑ˢ tm} {σ′ = (σ′ ↑ˢ tm) ↑ˢ tm} r (⇛ˢ-↑ (⇛ˢ-↑ pσ)))
         (⇛-sub {σ = σ} {σ′ = σ′} s pσ)

-- ─── 5.  the complete development ───────────────────────────────────
-- Structural recursion on the term, contracting every redex present.

_* : S ⊢ tm → S ⊢ tm
(var x) *                = var x
U *                      = U
Nat *                    = Nat
zeroN *                  = zeroN
(sucN t) *               = sucN (t *)
(Pi A B) *               = Pi (A *) (B *)
(lam A b) *              = lam (A *) (b *)
(app (lam A b) a) *      = (b *) [ (a *) ]₀
(app f a) *              = app (f *) (a *)
(natrec P z sc zeroN) *  = z *
(natrec P z sc (sucN n)) * =
  (sc *) [ natrec (P *) (z *) (sc *) (n *) ∙ˢ ((n *) ∙ˢ idˢ) ]ˢ
(natrec P z sc n) *      = natrec (P *) (z *) (sc *) (n *)

-- ─── 6.  the triangle:  t ⇛ u  implies  u ⇛ t*  ─────────────────────
-- The head of an application (resp. the argument of a natrec) has to be
-- split so that _*_ computes; every branch but the redex one is uniform.

⇛-△ : ∀ {S} {t u : S ⊢ tm} → t ⇛ u → u ⇛ (t *)
⇛-△ ⇛-var   = ⇛-var
⇛-△ ⇛-U     = ⇛-U
⇛-△ ⇛-Nat   = ⇛-Nat
⇛-△ ⇛-zeroN = ⇛-zeroN
⇛-△ (⇛-Pi p q)   = ⇛-Pi (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-lam p q)  = ⇛-lam (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-sucN p)   = ⇛-sucN (⇛-△ p)
⇛-△ (⇛-app {f = var _}      p q) = ⇛-app (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-app {f = U}          p q) = ⇛-app (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-app {f = Nat}        p q) = ⇛-app (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-app {f = zeroN}      p q) = ⇛-app (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-app {f = sucN _}     p q) = ⇛-app (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-app {f = Pi _ _}     p q) = ⇛-app (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-app {f = app _ _}    p q) = ⇛-app (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-app {f = natrec _ _ _ _} p q) = ⇛-app (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-app {f = lam _ _} (⇛-lam _ p) q) = ⇛-beta (⇛-△ p) (⇛-△ q)
⇛-△ (⇛-natrec {n = var _}    p q r s) = ⇛-natrec (⇛-△ p) (⇛-△ q) (⇛-△ r) (⇛-△ s)
⇛-△ (⇛-natrec {n = U}        p q r s) = ⇛-natrec (⇛-△ p) (⇛-△ q) (⇛-△ r) (⇛-△ s)
⇛-△ (⇛-natrec {n = Nat}      p q r s) = ⇛-natrec (⇛-△ p) (⇛-△ q) (⇛-△ r) (⇛-△ s)
⇛-△ (⇛-natrec {n = Pi _ _}   p q r s) = ⇛-natrec (⇛-△ p) (⇛-△ q) (⇛-△ r) (⇛-△ s)
⇛-△ (⇛-natrec {n = lam _ _}  p q r s) = ⇛-natrec (⇛-△ p) (⇛-△ q) (⇛-△ r) (⇛-△ s)
⇛-△ (⇛-natrec {n = app _ _}  p q r s) = ⇛-natrec (⇛-△ p) (⇛-△ q) (⇛-△ r) (⇛-△ s)
⇛-△ (⇛-natrec {n = natrec _ _ _ _} p q r s) =
  ⇛-natrec (⇛-△ p) (⇛-△ q) (⇛-△ r) (⇛-△ s)
⇛-△ (⇛-natrec {n = zeroN}    p q r ⇛-zeroN)     = ⇛-ιzero (⇛-△ q)
⇛-△ (⇛-natrec {n = sucN _}   p q r (⇛-sucN s))  = ⇛-ιsuc (⇛-△ p) (⇛-△ q) (⇛-△ r) (⇛-△ s)
-- the two redex constructors: here the substitution lemma does the work
⇛-△ (⇛-beta {b′ = b′} {a′ = a′} p q) =
  ⇛-sub {σ = a′ ∙ˢ idˢ} p′ (⇛ˢ-∙ q′ ⇛ˢ-id)
  where p′ = ⇛-△ p
        q′ = ⇛-△ q
⇛-△ (⇛-ιzero p) = ⇛-△ p
⇛-△ (⇛-ιsuc {P′ = P′} {z′ = z′} {sc′ = sc′} {n′ = n′} p q r s) =
  ⇛-sub {σ = natrec P′ z′ sc′ n′ ∙ˢ (n′ ∙ˢ idˢ)}
        (⇛-△ r)
        (⇛ˢ-∙ (⇛-natrec (⇛-△ p) (⇛-△ q) (⇛-△ r) (⇛-△ s))
              (⇛ˢ-∙ (⇛-△ s) ⇛ˢ-id))

-- ─── 7.  diamond, and confluence of ⇛* ──────────────────────────────

⇛-diamond : ∀ {S} {t u v : S ⊢ tm} → t ⇛ u → t ⇛ v → ∃[ w ] ((u ⇛ w) × (v ⇛ w))
⇛-diamond {t = t} p q = t * , ⇛-△ p , ⇛-△ q

data _⇛*_ : S ⊢ tm → S ⊢ tm → Set where
  ⇛*-refl : ∀ {S} {t : S ⊢ tm} → t ⇛* t
  ⇛*-step : ∀ {S} {t u v : S ⊢ tm} → t ⇛ u → u ⇛* v → t ⇛* v

⇛*-strip : ∀ {S} {t u v : S ⊢ tm} → t ⇛ u → t ⇛* v → ∃[ w ] ((u ⇛* w) × (v ⇛ w))
⇛*-strip {u = u} p ⇛*-refl = u , ⇛*-refl , p
⇛*-strip p (⇛*-step q qs) with ⇛-diamond p q
... | w , pw , qw with ⇛*-strip qw qs
... | w′ , pw′ , qw′ = w′ , ⇛*-step pw pw′ , qw′

⇛*-confluent : ∀ {S} {t u v : S ⊢ tm} →
  t ⇛* u → t ⇛* v → ∃[ w ] ((u ⇛* w) × (v ⇛* w))
⇛*-confluent ⇛*-refl q = _ , q , ⇛*-refl
⇛*-confluent (⇛*-step p ps) q with ⇛*-strip p q
... | w , qw , pw with ⇛*-confluent ps qw
... | w′ , pw′ , qw′ = w′ , pw′ , ⇛*-step pw qw′

-- ─── 8.  ↪ ⊆ ⇛ ⊆ ↠, hence ⇛* and ↠ coincide ────────────────────────

↠-trans : ∀ {S} {A B C : S ⊢ tm} → A ↠ B → B ↠ C → A ↠ C
↠-trans ↠-refl        q = q
↠-trans (↠-step r rs) q = ↠-step r (↠-trans rs q)

↠-map : ∀ {S₁ S₂} (g : S₁ ⊢ tm → S₂ ⊢ tm) →
  (∀ {u v} → u ↪ v → g u ↪ g v) → ∀ {u v} → u ↠ v → g u ↠ g v
↠-map g c ↠-refl        = ↠-refl
↠-map g c (↠-step r rs) = ↠-step (c r) (↠-map g c rs)

↪→⇛ : ∀ {S} {A B : S ⊢ tm} → A ↪ B → A ⇛ B
↪→⇛ (β-app {A = A} {b = b} {a = a}) = ⇛-beta (⇛-refl b) (⇛-refl a)
↪→⇛ (ι-zero {z = z}) = ⇛-ιzero (⇛-refl z)
↪→⇛ (ι-suc {P = P} {z = z} {sc = sc} {n = n}) =
  ⇛-ιsuc (⇛-refl P) (⇛-refl z) (⇛-refl sc) (⇛-refl n)
↪→⇛ (ξ-Pi₁ {B = B} r)  = ⇛-Pi (↪→⇛ r) (⇛-refl B)
↪→⇛ (ξ-Pi₂ {A = A} r)  = ⇛-Pi (⇛-refl A) (↪→⇛ r)
↪→⇛ (ξ-lam₁ {b = b} r) = ⇛-lam (↪→⇛ r) (⇛-refl b)
↪→⇛ (ξ-lam₂ {A = A} r) = ⇛-lam (⇛-refl A) (↪→⇛ r)
↪→⇛ (ξ-app₁ {a = a} r) = ⇛-app (↪→⇛ r) (⇛-refl a)
↪→⇛ (ξ-app₂ {f = f} r) = ⇛-app (⇛-refl f) (↪→⇛ r)
↪→⇛ (ξ-sucN r)         = ⇛-sucN (↪→⇛ r)
↪→⇛ (ξ-natrec₁ {z = z} {sc = sc} {n = n} r) =
  ⇛-natrec (↪→⇛ r) (⇛-refl z) (⇛-refl sc) (⇛-refl n)
↪→⇛ (ξ-natrec₂ {P = P} {sc = sc} {n = n} r) =
  ⇛-natrec (⇛-refl P) (↪→⇛ r) (⇛-refl sc) (⇛-refl n)
↪→⇛ (ξ-natrec₃ {P = P} {z = z} {n = n} r) =
  ⇛-natrec (⇛-refl P) (⇛-refl z) (↪→⇛ r) (⇛-refl n)
↪→⇛ (ξ-natrec₄ {P = P} {z = z} {sc = sc} r) =
  ⇛-natrec (⇛-refl P) (⇛-refl z) (⇛-refl sc) (↪→⇛ r)

⇛→↠ : ∀ {S} {A B : S ⊢ tm} → A ⇛ B → A ↠ B
⇛→↠ ⇛-var   = ↠-refl
⇛→↠ ⇛-U     = ↠-refl
⇛→↠ ⇛-Nat   = ↠-refl
⇛→↠ ⇛-zeroN = ↠-refl
⇛→↠ (⇛-Pi {A = A} {A′ = A′} {B = B} {B′ = B′} p q) =
  ↠-trans (↠-map (λ x → Pi x B)  ξ-Pi₁ (⇛→↠ p))
          (↠-map (λ x → Pi A′ x) ξ-Pi₂ (⇛→↠ q))
⇛→↠ (⇛-lam {A = A} {A′ = A′} {b = b} {b′ = b′} p q) =
  ↠-trans (↠-map (λ x → lam x b)  ξ-lam₁ (⇛→↠ p))
          (↠-map (λ x → lam A′ x) ξ-lam₂ (⇛→↠ q))
⇛→↠ (⇛-app {f = f} {f′ = f′} {a = a} {a′ = a′} p q) =
  ↠-trans (↠-map (λ x → app x a)  ξ-app₁ (⇛→↠ p))
          (↠-map (λ x → app f′ x) ξ-app₂ (⇛→↠ q))
⇛→↠ (⇛-sucN p) = ↠-map sucN ξ-sucN (⇛→↠ p)
⇛→↠ (⇛-natrec {P = P} {P′ = P′} {z = z} {z′ = z′}
              {sc = sc} {sc′ = sc′} {n = n} {n′ = n′} p q r s) =
  ↠-trans (↠-map (λ x → natrec x z sc n)     ξ-natrec₁ (⇛→↠ p))
  (↠-trans (↠-map (λ x → natrec P′ x sc n)   ξ-natrec₂ (⇛→↠ q))
  (↠-trans (↠-map (λ x → natrec P′ z′ x n)   ξ-natrec₃ (⇛→↠ r))
           (↠-map (λ x → natrec P′ z′ sc′ x) ξ-natrec₄ (⇛→↠ s))))
⇛→↠ (⇛-beta {b = b} {b′ = b′} {a = a} {a′ = a′} {A = A} p q) =
  ↠-trans (↠-map (λ x → app (lam A x) a) (λ e → ξ-app₁ (ξ-lam₂ e)) (⇛→↠ p))
  (↠-trans (↠-map (λ x → app (lam A b′) x) ξ-app₂ (⇛→↠ q))
           (↠-step (β-app {A = A} {b = b′} {a = a′}) ↠-refl))
⇛→↠ (⇛-ιzero {z = z} {z′ = z′} {P = P} {sc = sc} p) =
  ↠-step (ι-zero {P = P} {z = z} {sc = sc}) (⇛→↠ p)
⇛→↠ (⇛-ιsuc {P = P} {P′ = P′} {z = z} {z′ = z′}
            {sc = sc} {sc′ = sc′} {n = n} {n′ = n′} p q r s) =
  ↠-trans (↠-map (λ x → natrec x z sc (sucN n))      ξ-natrec₁ (⇛→↠ p))
  (↠-trans (↠-map (λ x → natrec P′ x sc (sucN n))    ξ-natrec₂ (⇛→↠ q))
  (↠-trans (↠-map (λ x → natrec P′ z′ x (sucN n))    ξ-natrec₃ (⇛→↠ r))
  (↠-trans (↠-map (λ x → natrec P′ z′ sc′ (sucN x))
                  (λ e → ξ-natrec₄ (ξ-sucN e)) (⇛→↠ s))
           (↠-step (ι-suc {P = P′} {z = z′} {sc = sc′} {n = n′}) ↠-refl))))

↠→⇛* : ∀ {S} {A B : S ⊢ tm} → A ↠ B → A ⇛* B
↠→⇛* ↠-refl        = ⇛*-refl
↠→⇛* (↠-step r rs) = ⇛*-step (↪→⇛ r) (↠→⇛* rs)

⇛*→↠ : ∀ {S} {A B : S ⊢ tm} → A ⇛* B → A ↠ B
⇛*→↠ ⇛*-refl        = ↠-refl
⇛*→↠ (⇛*-step p ps) = ↠-trans (⇛→↠ p) (⇛*→↠ ps)

-- ─── 9.  confluence of ↠, and Church-Rosser ─────────────────────────

↠-confluent : ∀ {S} {A B C : S ⊢ tm} → A ↠ B → A ↠ C →
  ∃[ D ] ((B ↠ D) × (C ↠ D))
↠-confluent p q with ⇛*-confluent (↠→⇛* p) (↠→⇛* q)
... | D , r , s = D , ⇛*→↠ r , ⇛*→↠ s

CR : ∀ {S} {A B : S ⊢ tm} → A ≡β B → ∃[ C ] ((A ↠ C) × (B ↠ C))
CR {A = A} β-refl   = A , ↠-refl , ↠-refl
CR {B = B} (β-step r) = B , ↠-step r ↠-refl , ↠-refl
CR (β-sym e) with CR e
... | C , p , q = C , q , p
CR (β-trans e f) with CR e | CR f
... | C₁ , p₁ , q₁ | C₂ , p₂ , q₂ with ↠-confluent q₁ p₂
... | D , r , s = D , ↠-trans p₁ r , ↠-trans q₂ s

-- ─── 10.  positive controls for the Church-Rosser proof ─────────────
-- Without these, `_*`, `⇛-△` and `CR` could all be vacuously fine.

-- The complete development really contracts the β-redex, and the
-- REWRITE system computes the resulting substitution:
dev-β : (app (lam U (sucN (var zero))) Nat) * ≡ sucN {S = []} Nat
dev-β = refl

-- …and the ι-suc redex, whose contractum is the TWO-VARIABLE
-- substitution.  Here the successor branch is `var (suc zero)`, the
-- predecessor slot, so the development must return `n *`:
dev-ι : (natrec U Nat (var (suc zero)) (sucN zeroN)) * ≡ zeroN {S = []}
dev-ι = refl

-- …and `var zero`, the induction-hypothesis slot, must return the
-- recursive call:
dev-ι-IH : (natrec U Nat (var zero) (sucN zeroN)) *
         ≡ natrec {S = []} U Nat (var zero) zeroN
dev-ι-IH = refl

-- A genuine critical pair: one term, two different one-step reducts,
-- joined by the confluence theorem.
cp-src : [] ⊢ tm
cp-src = app (lam U (sucN (var zero))) (natrec Nat zeroN (var zero) zeroN)

cp-β : cp-src ↪ sucN (natrec Nat zeroN (var zero) zeroN)
cp-β = β-app

cp-ι : cp-src ↪ app (lam U (sucN (var zero))) zeroN
cp-ι = ξ-app₂ ι-zero

cp-join : ∃[ D ] ((sucN (natrec Nat zeroN (var zero) zeroN) ↠ D)
                × (app (lam U (sucN (var zero))) zeroN ↠ D))
cp-join = ↠-confluent (↠-step cp-β ↠-refl) (↠-step cp-ι ↠-refl)

-- and the join really is the normal form `sucN zeroN`
cp-join-is : proj₁ cp-join ≡ sucN {S = []} zeroN
cp-join-is = refl

-- CR itself, on a conversion built from both redexes
cr-probe : ∃[ C ] ((sucN (natrec Nat zeroN (var zero) zeroN) ↠ C)
                 × (app (lam U (sucN (var zero))) zeroN ↠ C))
cr-probe = CR (β-trans (β-sym (β-step cp-β)) (β-step cp-ι))

-- ════════════════════════════════════════════════════════════════════
-- Head analysis of ↠ for the three type formers.  All PROVED.
-- ════════════════════════════════════════════════════════════════════

↠-Pi-inv : ∀ {S} {A C : S ⊢ tm} {B : (tm ∷ S) ⊢ tm} → Pi A B ↠ C →
  ∃[ A′ ] ∃[ B′ ] ((C ≡ Pi A′ B′) × (A ↠ A′) × (B ↠ B′))
↠-Pi-inv ↠-refl = _ , _ , refl , ↠-refl , ↠-refl
↠-Pi-inv (↠-step (ξ-Pi₁ r) rs) with ↠-Pi-inv rs
... | A′ , B′ , refl , rA , rB = A′ , B′ , refl , ↠-step r rA , rB
↠-Pi-inv (↠-step (ξ-Pi₂ r) rs) with ↠-Pi-inv rs
... | A′ , B′ , refl , rA , rB = A′ , B′ , refl , rA , ↠-step r rB

↠-U-inv : ∀ {S} {C : S ⊢ tm} → U ↠ C → C ≡ U
↠-U-inv ↠-refl = refl

↠-Nat-inv : ∀ {S} {C : S ⊢ tm} → Nat ↠ C → C ≡ Nat
↠-Nat-inv ↠-refl = refl

-- ════════════════════════════════════════════════════════════════════
-- Pi-injectivity and no-confusion.  All PROVED from CR.
-- ════════════════════════════════════════════════════════════════════

Pi-inj : ∀ {S} {A A′ : S ⊢ tm} {B B′ : (tm ∷ S) ⊢ tm} →
  Pi A B ≡β Pi A′ B′ → (A ≡β A′) × (B ≡β B′)
Pi-inj e with CR e
... | C , r₁ , r₂ with ↠-Pi-inv r₁ | ↠-Pi-inv r₂
... | A₁ , B₁ , refl , rA₁ , rB₁ | A₂ , B₂ , eq , rA₂ , rB₂ with eq
... | refl = β-trans (↠→≡β rA₁) (β-sym (↠→≡β rA₂))
           , β-trans (↠→≡β rB₁) (β-sym (↠→≡β rB₂))

U≁Pi : ∀ {S} {A : S ⊢ tm} {B : (tm ∷ S) ⊢ tm} → U ≡β Pi A B → ⊥
U≁Pi e with CR e
... | C , r₁ , r₂ with ↠-U-inv r₁
... | refl with ↠-Pi-inv r₂
... | _ , _ , () , _ , _

Nat≁Pi : ∀ {S} {A : S ⊢ tm} {B : (tm ∷ S) ⊢ tm} → Nat ≡β Pi A B → ⊥
Nat≁Pi e with CR e
... | C , r₁ , r₂ with ↠-Nat-inv r₁
... | refl with ↠-Pi-inv r₂
... | _ , _ , () , _ , _

U≁Nat : ∀ {S} → U {S = S} ≡β Nat → ⊥
U≁Nat e with CR e
... | C , r₁ , r₂ with ↠-U-inv r₁
... | refl with ↠-Nat-inv r₂
... | ()

-- ═══ RENAMING AND SUBSTITUTION PRESERVE TYPING ═══════════════════════════════════════════

-- Preservation (subject reduction) for β and ι.
--
-- Bookkeeping for the experiment.  Every place where a substitution
-- equation had to be stated and applied BY HAND is marked
--    -- HAND-LEMMA n: <name>
-- every place where the framework discharged one definitionally is
--    -- definitional: <name>



-- ════════════════════════════════════════════════════════════════════
-- 1.  Reduction and conversion are stable under substitution.
--
-- This obligation does NOT exist in the System F development: there,
-- conversion does not occur in the typing rules, so `sub-pres` never has
-- to push a substitution through a reduction.  In MLTT the conversion
-- rule forces it.  It is new WORK, but it costs no new substitution
-- lemma: every equation it raises is already a rewrite.
-- ════════════════════════════════════════════════════════════════════

↪-sub : ∀ {S₁ S₂} {t t′ : S₁ ⊢ tm} {σ : S₁ →ˢ S₂} →
  t ↪ t′ → (t [ σ ]ˢ) ↪ (t′ [ σ ]ˢ)
-- The three redex cases must PIN the constructor's implicits: with the
-- two-world rule set the goal's index has already been rewritten, so
-- Agda can no longer read the arguments back off it.  This is exactly
-- the note in systemf.agda's `sr`.  It is a UNIFICATION cost, not a
-- substitution lemma: once pinned, the equation closes by refl.
-- definitional: probe 1 (subst-commute)
↪-sub {σ = σ} (β-app {A = A} {b = b} {a = a}) =
  β-app {A = A [ σ ]ˢ} {b = b [ σ ↑ˢ tm ]ˢ} {a = a [ σ ]ˢ}
↪-sub {σ = σ} (ι-zero {P = P} {z = z} {sc = sc}) =
  ι-zero {P = P [ σ ↑ˢ tm ]ˢ} {z = z [ σ ]ˢ} {sc = sc [ (σ ↑ˢ tm) ↑ˢ tm ]ˢ}
-- definitional: probe 3 (the two-variable ι-suc law)
↪-sub {σ = σ} (ι-suc {P = P} {z = z} {sc = sc} {n = n}) =
  ι-suc {P = P [ σ ↑ˢ tm ]ˢ} {z = z [ σ ]ˢ}
        {sc = sc [ (σ ↑ˢ tm) ↑ˢ tm ]ˢ} {n = n [ σ ]ˢ}
↪-sub {σ = σ} (ξ-Pi₁ r)     = ξ-Pi₁     (↪-sub {σ = σ} r)
↪-sub {σ = σ} (ξ-Pi₂ r)     = ξ-Pi₂     (↪-sub {σ = σ ↑ˢ tm} r)
↪-sub {σ = σ} (ξ-lam₁ r)    = ξ-lam₁    (↪-sub {σ = σ} r)
↪-sub {σ = σ} (ξ-lam₂ r)    = ξ-lam₂    (↪-sub {σ = σ ↑ˢ tm} r)
↪-sub {σ = σ} (ξ-app₁ r)    = ξ-app₁    (↪-sub {σ = σ} r)
↪-sub {σ = σ} (ξ-app₂ r)    = ξ-app₂    (↪-sub {σ = σ} r)
↪-sub {σ = σ} (ξ-sucN r)    = ξ-sucN    (↪-sub {σ = σ} r)
↪-sub {σ = σ} (ξ-natrec₁ r) = ξ-natrec₁ (↪-sub {σ = σ ↑ˢ tm} r)
↪-sub {σ = σ} (ξ-natrec₂ r) = ξ-natrec₂ (↪-sub {σ = σ} r)
↪-sub {σ = σ} (ξ-natrec₃ r) = ξ-natrec₃ (↪-sub {σ = (σ ↑ˢ tm) ↑ˢ tm} r)
↪-sub {σ = σ} (ξ-natrec₄ r) = ξ-natrec₄ (↪-sub {σ = σ} r)

≡β-sub : ∀ {S₁ S₂} {A B : S₁ ⊢ tm} {σ : S₁ →ˢ S₂} →
  A ≡β B → (A [ σ ]ˢ) ≡β (B [ σ ]ˢ)
≡β-sub β-refl        = β-refl
≡β-sub {σ = σ} (β-step r)    = β-step (↪-sub {σ = σ} r)
≡β-sub {σ = σ} (β-sym e)     = β-sym (≡β-sub {σ = σ} e)
≡β-sub {σ = σ} (β-trans e f) = β-trans (≡β-sub {σ = σ} e) (≡β-sub {σ = σ} f)

-- definitional: probe 6 (coincidence).  The renaming versions are the
-- σ-versions at σ := ⟨ ξ ⟩.  No separate induction, no transport.
↪-ren : ∀ {S₁ S₂} {t t′ : S₁ ⊢ tm} {ξ : S₁ →ᴿ S₂} →
  t ↪ t′ → (t [ ξ ]ᴿ) ↪ (t′ [ ξ ]ᴿ)
↪-ren {ξ = ξ} r = ↪-sub {σ = ⟨ ξ ⟩} r

≡β-ren : ∀ {S₁ S₂} {A B : S₁ ⊢ tm} {ξ : S₁ →ᴿ S₂} →
  A ≡β B → (A [ ξ ]ᴿ) ≡β (B [ ξ ]ᴿ)
≡β-ren {ξ = ξ} e = ≡β-sub {σ = ⟨ ξ ⟩} e

-- ════════════════════════════════════════════════════════════════════
-- 2.  Typed maps: phase 1 renamings, phase 2 substitutions.
-- ════════════════════════════════════════════════════════════════════

_∶_→ᴿ_ : S₁ →ᴿ S₂ → Ctx S₁ → Ctx S₂ → Set
_∶_→ᴿ_ {S₁} ξ Γ₁ Γ₂ = ∀ (x : S₁ ∋ tm) (t : S₁ ∶⊢ tm) →
  Γ₁ ∋ x ∶ t → Γ₂ ∋ (x [ ξ ]ᴿ) ∶ (t [ ξ ]ᴿ)

_∶_→ˢ_ : S₁ →ˢ S₂ → Ctx S₁ → Ctx S₂ → Set
_∶_→ˢ_ {S₁} σ Γ₁ Γ₂ = ∀ (x : S₁ ∋ tm) (t : S₁ ∶⊢ tm) →
  Γ₁ ∋ x ∶ t → Γ₂ ⊢ (x [ σ ]ˢ) ∶ (t [ σ ]ˢ)

⊢wkᴿ : ∀ {S} {Γ : Ctx S} (t′ : S ∶⊢ tm) → wkᴿ tm ∶ Γ →ᴿ (t′ ∷ₜ Γ)
⊢wkᴿ t′ x _ refl = refl

⊢↑ᴿ : ∀ {S₁ S₂} {ξ : S₁ →ᴿ S₂} {Γ₁ : Ctx S₁} {Γ₂ : Ctx S₂} → ξ ∶ Γ₁ →ᴿ Γ₂ →
  (t : S₁ ∶⊢ tm) → (ξ ↑ᴿ tm) ∶ (t ∷ₜ Γ₁) →ᴿ ((t [ ξ ]ᴿ) ∷ₜ Γ₂)
⊢↑ᴿ ⊢ξ t zero    _ refl = refl
⊢↑ᴿ ⊢ξ t (suc x) _ refl = cong weaken (⊢ξ x _ refl)

ren-pres : ∀ {S₁ S₂} {ξ : S₁ →ᴿ S₂} {Γ₁ : Ctx S₁} {Γ₂ : Ctx S₂}
  {e : S₁ ⊢ tm} {t : S₁ ⊢ tm} →
  Γ₁ ⊢ e ∶ t → ξ ∶ Γ₁ →ᴿ Γ₂ → Γ₂ ⊢ (e [ ξ ]ᴿ) ∶ (t [ ξ ]ᴿ)
ren-pres (⊢var ⊢x)     ⊢ξ = ⊢var (⊢ξ _ _ ⊢x)
ren-pres ⊢U            ⊢ξ = ⊢U
ren-pres (⊢Pi ⊢A ⊢B)   ⊢ξ = ⊢Pi (ren-pres ⊢A ⊢ξ) (ren-pres ⊢B (⊢↑ᴿ ⊢ξ _))
ren-pres (⊢lam ⊢A ⊢b)  ⊢ξ = ⊢lam (ren-pres ⊢A ⊢ξ) (ren-pres ⊢b (⊢↑ᴿ ⊢ξ _))
-- definitional: probe 1 at σ := ⟨ ξ ⟩
ren-pres (⊢app ⊢f ⊢a)  ⊢ξ = ⊢app (ren-pres ⊢f ⊢ξ) (ren-pres ⊢a ⊢ξ)
ren-pres ⊢Nat          ⊢ξ = ⊢Nat
ren-pres ⊢zeroN        ⊢ξ = ⊢zeroN
ren-pres (⊢sucN ⊢n)    ⊢ξ = ⊢sucN (ren-pres ⊢n ⊢ξ)
-- definitional: probes 4 and 5 at σ := ⟨ ξ ⟩
ren-pres (⊢natrec ⊢P ⊢z ⊢sc ⊢n) ⊢ξ =
  ⊢natrec (ren-pres ⊢P (⊢↑ᴿ ⊢ξ _)) (ren-pres ⊢z ⊢ξ)
          (ren-pres ⊢sc (⊢↑ᴿ (⊢↑ᴿ ⊢ξ _) _)) (ren-pres ⊢n ⊢ξ)
ren-pres (⊢conv ⊢a e) ⊢ξ = ⊢conv (ren-pres ⊢a ⊢ξ) (≡β-ren e)

⊢↑ˢ : ∀ {S₁ S₂} {σ : S₁ →ˢ S₂} {Γ₁ : Ctx S₁} {Γ₂ : Ctx S₂} →
  σ ∶ Γ₁ →ˢ Γ₂ → (t : S₁ ∶⊢ tm) →
  (σ ↑ˢ tm) ∶ (t ∷ₜ Γ₁) →ˢ ((t [ σ ]ˢ) ∷ₜ Γ₂)
⊢↑ˢ ⊢σ t zero    _ refl = ⊢var refl
⊢↑ˢ {σ = σ} {Γ₂ = Γ₂} ⊢σ t (suc x) _ refl =
  ren-pres (⊢σ x _ refl) (⊢wkᴿ {Γ = Γ₂} (t [ σ ]ˢ))

sub-pres : ∀ {S₁ S₂} {σ : S₁ →ˢ S₂} {Γ₁ : Ctx S₁} {Γ₂ : Ctx S₂}
  {e : S₁ ⊢ tm} {t : S₁ ⊢ tm} →
  Γ₁ ⊢ e ∶ t → σ ∶ Γ₁ →ˢ Γ₂ → Γ₂ ⊢ (e [ σ ]ˢ) ∶ (t [ σ ]ˢ)
sub-pres (⊢var ⊢x) ⊢σ = ⊢σ _ _ ⊢x
sub-pres ⊢U        ⊢σ = ⊢U
sub-pres {σ = σ} (⊢Pi ⊢A ⊢B)  ⊢σ =
  ⊢Pi (sub-pres {σ = σ} ⊢A ⊢σ) (sub-pres {σ = σ ↑ˢ tm} ⊢B (⊢↑ˢ {σ = σ} ⊢σ _))
sub-pres {σ = σ} (⊢lam ⊢A ⊢b) ⊢σ =
  ⊢lam (sub-pres {σ = σ} ⊢A ⊢σ) (sub-pres {σ = σ ↑ˢ tm} ⊢b (⊢↑ˢ {σ = σ} ⊢σ _))
-- definitional: probe 1.  ⊢app concludes at B [ a ]₀, so the two sides
-- are (B [ σ↑ ]) [ a[σ] ]₀ and (B [ a ]₀) [ σ ].
sub-pres {σ = σ} (⊢app ⊢f ⊢a) ⊢σ =
  ⊢app (sub-pres {σ = σ} ⊢f ⊢σ) (sub-pres {σ = σ} ⊢a ⊢σ)
sub-pres ⊢Nat   ⊢σ = ⊢Nat
sub-pres ⊢zeroN ⊢σ = ⊢zeroN
sub-pres {σ = σ} (⊢sucN ⊢n) ⊢σ = ⊢sucN (sub-pres {σ = σ} ⊢n ⊢σ)
-- definitional: probes 4 and 5.  The successor branch's type
-- `sucMotive P` must commute with the DOUBLE lift (σ↑)↑.
sub-pres {σ = σ} (⊢natrec ⊢P ⊢z ⊢sc ⊢n) ⊢σ =
  ⊢natrec (sub-pres {σ = σ ↑ˢ tm} ⊢P (⊢↑ˢ {σ = σ} ⊢σ _))
          (sub-pres {σ = σ} ⊢z ⊢σ)
          (sub-pres {σ = (σ ↑ˢ tm) ↑ˢ tm} ⊢sc (⊢↑ˢ {σ = σ ↑ˢ tm} (⊢↑ˢ {σ = σ} ⊢σ _) _))
          (sub-pres {σ = σ} ⊢n ⊢σ)
sub-pres {σ = σ} (⊢conv ⊢a e) ⊢σ =
  ⊢conv (sub-pres {σ = σ} ⊢a ⊢σ) (≡β-sub {σ = σ} e)

⊢[] : ∀ {S} {Γ : Ctx S} {e : S ⊢ tm} {t : S ⊢ tm} →
  Γ ⊢ e ∶ t → (e ∙ˢ idˢ) ∶ (t ∷ₜ Γ) →ˢ Γ
⊢[] ⊢e zero    _ refl = ⊢e
⊢[] ⊢e (suc x) _ refl = ⊢var refl

-- ═══ SUBJECT REDUCTION ═══════════════════════════════════════════

-- Subject reduction (preservation) for β and ι.
--
-- This file assumes NOTHING of its own.  It uses `Pi-inj`, which
-- this file PROVES from Church-Rosser for the
-- untyped calculus), a theorem orthogonal to the substitution machinery.



-- ════════════════════════════════════════════════════════════════════
-- 0.  Conversion in the substituted ARGUMENT.
--
-- Note the trick: no induction on the term is needed, because
-- conversion is symmetric and t [ a ]₀ is a β-reduct of app (lam U t) a.
-- ════════════════════════════════════════════════════════════════════

sub-arg-≡β : ∀ {S} (t : (tm ∷ S) ⊢ tm) {a a′ : S ⊢ tm} →
  a ↪ a′ → (t [ a ]₀) ≡β (t [ a′ ]₀)
sub-arg-≡β t {a} {a′} r =
  β-trans (β-sym (β-step (β-app {A = U} {b = t} {a = a})))
    (β-trans (β-step (ξ-app₂ {f = lam U t} r))
             (β-step (β-app {A = U} {b = t} {a = a′})))

-- ════════════════════════════════════════════════════════════════════
-- 1.  Context conversion.
-- ════════════════════════════════════════════════════════════════════

_≈_ : ∀ {S} → Ctx S → Ctx S → Set
_≈_ {S} Γ₁ Γ₂ = ∀ (x : S ∋ tm) → wk-telescope Γ₁ x ≡β wk-telescope Γ₂ x

-- both use only `≡β-ren`, itself an instance of `≡β-sub` (probe 6)
ext-≈ : ∀ {S} {Γ₁ Γ₂ : Ctx S} {A : S ⊢ tm} → Γ₁ ≈ Γ₂ → (A ∷ₜ Γ₁) ≈ (A ∷ₜ Γ₂)
ext-≈ c zero    = β-refl
ext-≈ c (suc x) = ≡β-ren (c x)

cons-≈ : ∀ {S} {Γ : Ctx S} {A A′ : S ⊢ tm} → A ≡β A′ → (A ∷ₜ Γ) ≈ (A′ ∷ₜ Γ)
cons-≈ e zero    = ≡β-ren e
cons-≈ e (suc x) = β-refl

ctx-conv : ∀ {S} {Γ₁ Γ₂ : Ctx S} {e A : S ⊢ tm} →
  Γ₁ ≈ Γ₂ → Γ₁ ⊢ e ∶ A → Γ₂ ⊢ e ∶ A
ctx-conv c (⊢var {x = x} refl)  = ⊢conv (⊢var refl) (β-sym (c x))
ctx-conv c ⊢U                   = ⊢U
ctx-conv c (⊢Pi ⊢A ⊢B)          = ⊢Pi (ctx-conv c ⊢A) (ctx-conv (ext-≈ c) ⊢B)
ctx-conv c (⊢lam ⊢A ⊢b)         = ⊢lam (ctx-conv c ⊢A) (ctx-conv (ext-≈ c) ⊢b)
ctx-conv c (⊢app ⊢f ⊢a)         = ⊢app (ctx-conv c ⊢f) (ctx-conv c ⊢a)
ctx-conv c ⊢Nat                 = ⊢Nat
ctx-conv c ⊢zeroN               = ⊢zeroN
ctx-conv c (⊢sucN ⊢n)           = ⊢sucN (ctx-conv c ⊢n)
ctx-conv c (⊢natrec ⊢P ⊢z ⊢sc ⊢n) =
  ⊢natrec (ctx-conv (ext-≈ c) ⊢P) (ctx-conv c ⊢z)
          (ctx-conv (ext-≈ (ext-≈ c)) ⊢sc) (ctx-conv c ⊢n)
ctx-conv c (⊢conv ⊢a e)         = ⊢conv (ctx-conv c ⊢a) e

-- ════════════════════════════════════════════════════════════════════
-- 2.  Inversion.  Both go through ⊢conv without needing injectivity.
-- ════════════════════════════════════════════════════════════════════

inv-sucN : ∀ {S} {Γ : Ctx S} {n A : S ⊢ tm} → Γ ⊢ (sucN n) ∶ A → Γ ⊢ n ∶ Nat
inv-sucN (⊢sucN ⊢n)  = ⊢n
inv-sucN (⊢conv ⊢t e) = inv-sucN ⊢t

inv-lam : ∀ {S} {Γ : Ctx S} {A₀ C : S ⊢ tm} {b : (tm ∷ S) ⊢ tm} →
  Γ ⊢ (lam A₀ b) ∶ C →
  ∃[ B ] ((C ≡β Pi A₀ B) × ((A₀ ∷ₜ Γ) ⊢ b ∶ B))
inv-lam (⊢lam ⊢A ⊢b)  = _ , β-refl , ⊢b
inv-lam (⊢conv ⊢t e) with inv-lam ⊢t
... | B , eq , ⊢b = B , β-trans (β-sym e) eq , ⊢b

-- ════════════════════════════════════════════════════════════════════
-- 3.  Pi-injectivity comes from mltt-cr, where it is PROVED from the
-- proved Church-Rosser theorem for the untyped calculus.
-- ════════════════════════════════════════════════════════════════════

-- ════════════════════════════════════════════════════════════════════
-- 4.  The typed map for the ι-suc redex.
-- ════════════════════════════════════════════════════════════════════

⊢ιmap : ∀ {S} {Γ : Ctx S} {P : (tm ∷ S) ⊢ tm} {z : S ⊢ tm}
  {sc : (tm ∷ tm ∷ S) ⊢ tm} {n : S ⊢ tm} →
  Γ ⊢ (natrec P z sc n) ∶ (P [ n ]₀) → Γ ⊢ n ∶ Nat →
  (natrec P z sc n ∙ˢ (n ∙ˢ idˢ)) ∶ (P ∷ₜ (Nat ∷ₜ Γ)) →ˢ Γ
-- definitional: (weaken P) [ natrec .. ∙ˢ (n ∙ˢ idˢ) ]ˢ  reduces to
-- P [ n ]₀ by interact; the other two entries likewise.
⊢ιmap ⊢nr ⊢n zero          _ refl = ⊢nr
⊢ιmap ⊢nr ⊢n (suc zero)    _ refl = ⊢n
⊢ιmap ⊢nr ⊢n (suc (suc x)) _ refl = ⊢var refl

-- ════════════════════════════════════════════════════════════════════
-- 5.  Subject reduction.
-- ════════════════════════════════════════════════════════════════════

sr : ∀ {S} {Γ : Ctx S} {e e′ A : S ⊢ tm} → Γ ⊢ e ∶ A → e ↪ e′ → Γ ⊢ e′ ∶ A

-- β.  Needs Pi-inj (via inv-lam): ⊢f may have gone through ⊢conv, so
-- the Pi in ⊢app's premise need not be the lam's own Pi syntactically.
-- definitional: probe 1 -- the conclusion B [ a ]₀ is exactly what
-- sub-pres delivers, no substitution lemma applied.
sr (⊢app {A = A} {B = B} {a = a} ⊢f ⊢a) β-app with inv-lam ⊢f
... | B₀ , eq , ⊢b with Pi-inj eq
... | eA , eB =
  ⊢conv (sub-pres {σ = a ∙ˢ idˢ} ⊢b (⊢[] (⊢conv ⊢a eA)))
        (≡β-sub {σ = a ∙ˢ idˢ} (β-sym eB))

-- ι-zero.  The conclusion type P [ zeroN ]₀ is literally ⊢z's type.
sr (⊢natrec ⊢P ⊢z ⊢sc ⊢n) ι-zero = ⊢z

-- ι-suc.  definitional: the sucMotive law (probe 4) instantiated at the
-- ι-substitution; sub-pres delivers exactly P [ sucN n ]₀.
sr (⊢natrec {P = P} {z = z} {sc = sc} ⊢P ⊢z ⊢sc ⊢sn) (ι-suc {n = n}) =
  let ⊢n = inv-sucN ⊢sn
      ⊢nr = ⊢natrec ⊢P ⊢z ⊢sc ⊢n
  in sub-pres {σ = natrec P z sc n ∙ˢ (n ∙ˢ idˢ)} ⊢sc (⊢ιmap ⊢nr ⊢n)

-- congruences
sr (⊢Pi ⊢A ⊢B)  (ξ-Pi₁ r) = ⊢Pi (sr ⊢A r) (ctx-conv (cons-≈ (β-step r)) ⊢B)
sr (⊢Pi ⊢A ⊢B)  (ξ-Pi₂ r) = ⊢Pi ⊢A (sr ⊢B r)
sr (⊢lam ⊢A ⊢b) (ξ-lam₁ r) =
  ⊢conv (⊢lam (sr ⊢A r) (ctx-conv (cons-≈ (β-step r)) ⊢b))
        (β-sym (β-step (ξ-Pi₁ r)))
sr (⊢lam ⊢A ⊢b) (ξ-lam₂ r) = ⊢lam ⊢A (sr ⊢b r)
sr (⊢app ⊢f ⊢a) (ξ-app₁ r) = ⊢app (sr ⊢f r) ⊢a
sr (⊢app {B = B} ⊢f ⊢a) (ξ-app₂ r) =
  ⊢conv (⊢app ⊢f (sr ⊢a r)) (β-sym (sub-arg-≡β B r))
sr (⊢sucN ⊢n) (ξ-sucN r) = ⊢sucN (sr ⊢n r)
sr (⊢natrec {P = P} {n = n} ⊢P ⊢z ⊢sc ⊢n) (ξ-natrec₁ r) =
  ⊢conv (⊢natrec (sr ⊢P r)
                 (⊢conv ⊢z (≡β-sub {σ = zeroN ∙ˢ idˢ} (β-step r)))
                 (⊢conv (ctx-conv (cons-≈ (β-step r)) ⊢sc)
                        (β-step (↪-ren {ξ = wkᴿ tm}
                           (↪-sub {σ = sucN (var zero) ∙ˢ wkˢ tm} r))))
                 ⊢n)
        (β-sym (β-step (↪-sub {σ = n ∙ˢ idˢ} r)))
sr (⊢natrec ⊢P ⊢z ⊢sc ⊢n) (ξ-natrec₂ r) = ⊢natrec ⊢P (sr ⊢z r) ⊢sc ⊢n
sr (⊢natrec ⊢P ⊢z ⊢sc ⊢n) (ξ-natrec₃ r) = ⊢natrec ⊢P ⊢z (sr ⊢sc r) ⊢n
sr (⊢natrec {P = P} ⊢P ⊢z ⊢sc ⊢n) (ξ-natrec₄ r) =
  ⊢conv (⊢natrec ⊢P ⊢z ⊢sc (sr ⊢n r)) (β-sym (sub-arg-≡β P r))

sr (⊢conv ⊢t e) st = ⊢conv (sr ⊢t st) e

-- ═══ PROGRESS ═══════════════════════════════════════════

-- Progress for closed terms.
--
-- Assumes nothing of its own.  Uses Pi-inj / U≁Pi / Nat≁Pi / U≁Nat from
-- above, all PROVED from the Church-Rosser theorem.



-- ─── values (weak head normal forms) ────────────────────────────────

data Val {S} : S ⊢ tm → Set where
  vU     : Val U
  vPi    : ∀ {A B} → Val (Pi A B)
  vNat   : Val Nat
  vlam   : ∀ {A b} → Val (lam A b)
  vzeroN : Val zeroN
  vsucN  : ∀ {n} → Val (sucN n)

-- ─── inversion: the principal type of each value former, up to ≡β ────
-- All go through ⊢conv without needing any confluence fact.

inv-U-ty : ∀ {S} {Γ : Ctx S} {C : S ⊢ tm} → Γ ⊢ U ∶ C → C ≡β U
inv-U-ty ⊢U           = β-refl
inv-U-ty (⊢conv ⊢t e) = β-trans (β-sym e) (inv-U-ty ⊢t)

inv-Pi-ty : ∀ {S} {Γ : Ctx S} {A C : S ⊢ tm} {B : (tm ∷ S) ⊢ tm} →
  Γ ⊢ (Pi A B) ∶ C → C ≡β U
inv-Pi-ty (⊢Pi _ _)    = β-refl
inv-Pi-ty (⊢conv ⊢t e) = β-trans (β-sym e) (inv-Pi-ty ⊢t)

inv-Nat-ty : ∀ {S} {Γ : Ctx S} {C : S ⊢ tm} → Γ ⊢ Nat ∶ C → C ≡β U
inv-Nat-ty ⊢Nat          = β-refl
inv-Nat-ty (⊢conv ⊢t e)  = β-trans (β-sym e) (inv-Nat-ty ⊢t)

inv-zeroN-ty : ∀ {S} {Γ : Ctx S} {C : S ⊢ tm} → Γ ⊢ zeroN ∶ C → C ≡β Nat
inv-zeroN-ty ⊢zeroN        = β-refl
inv-zeroN-ty (⊢conv ⊢t e)  = β-trans (β-sym e) (inv-zeroN-ty ⊢t)

inv-sucN-ty : ∀ {S} {Γ : Ctx S} {n C : S ⊢ tm} → Γ ⊢ (sucN n) ∶ C → C ≡β Nat
inv-sucN-ty (⊢sucN _)     = β-refl
inv-sucN-ty (⊢conv ⊢t e)  = β-trans (β-sym e) (inv-sucN-ty ⊢t)

-- ─── canonical forms ────────────────────────────────────────────────

cf-Pi : ∀ {S} {Γ : Ctx S} {v A : S ⊢ tm} {B : (tm ∷ S) ⊢ tm} →
  Γ ⊢ v ∶ (Pi A B) → Val v → ∃[ A₀ ] ∃[ b ] (v ≡ lam A₀ b)
cf-Pi ⊢v vU     = ⊥-elim (U≁Pi   (β-sym (inv-U-ty     ⊢v)))
cf-Pi ⊢v vPi    = ⊥-elim (U≁Pi   (β-sym (inv-Pi-ty    ⊢v)))
cf-Pi ⊢v vNat   = ⊥-elim (U≁Pi   (β-sym (inv-Nat-ty   ⊢v)))
cf-Pi ⊢v vzeroN = ⊥-elim (Nat≁Pi (β-sym (inv-zeroN-ty ⊢v)))
cf-Pi ⊢v vsucN  = ⊥-elim (Nat≁Pi (β-sym (inv-sucN-ty  ⊢v)))
cf-Pi ⊢v vlam   = _ , _ , refl

cf-Nat : ∀ {S} {Γ : Ctx S} {v : S ⊢ tm} →
  Γ ⊢ v ∶ Nat → Val v → (v ≡ zeroN) ⊎ (∃[ n ] (v ≡ sucN n))
cf-Nat ⊢v vU     = ⊥-elim (U≁Nat   (β-sym (inv-U-ty   ⊢v)))
cf-Nat ⊢v vPi    = ⊥-elim (U≁Nat   (β-sym (inv-Pi-ty  ⊢v)))
cf-Nat ⊢v vNat   = ⊥-elim (U≁Nat   (β-sym (inv-Nat-ty ⊢v)))
cf-Nat ⊢v vlam   with inv-lam ⊢v
... | _ , eq , _ = ⊥-elim (Nat≁Pi eq)
cf-Nat ⊢v vzeroN = inj₁ refl
cf-Nat ⊢v vsucN  = inj₂ (_ , refl)

-- ─── progress ───────────────────────────────────────────────────────

∅ : Ctx []
∅ _ ()

progress : ∀ {e A : [] ⊢ tm} → ∅ ⊢ e ∶ A → Val e ⊎ ∃[ e′ ] (e ↪ e′)
progress (⊢var {x = ()} _)
progress ⊢U            = inj₁ vU
progress (⊢Pi _ _)     = inj₁ vPi
progress (⊢lam _ _)    = inj₁ vlam
progress ⊢Nat          = inj₁ vNat
progress ⊢zeroN        = inj₁ vzeroN
progress (⊢sucN _)     = inj₁ vsucN
progress (⊢app ⊢f ⊢a) with progress ⊢f
... | inj₂ (f′ , r) = inj₂ (_ , ξ-app₁ r)
... | inj₁ vf with cf-Pi ⊢f vf
... | A₀ , b , refl = inj₂ (_ , β-app)
progress (⊢natrec ⊢P ⊢z ⊢sc ⊢n) with progress ⊢n
... | inj₂ (n′ , r) = inj₂ (_ , ξ-natrec₄ r)
... | inj₁ vn with cf-Nat ⊢n vn
... | inj₁ refl        = inj₂ (_ , ι-zero)
... | inj₂ (n′ , refl) = inj₂ (_ , ι-suc)
progress (⊢conv ⊢t e) = progress ⊢t

-- ─── type safety ────────────────────────────────────────────────────

sr* : ∀ {e e′ A : [] ⊢ tm} → ∅ ⊢ e ∶ A → e ↠ e′ → ∅ ⊢ e′ ∶ A
sr* ⊢e ↠-refl        = ⊢e
sr* ⊢e (↠-step r rs) = sr* (sr ⊢e r) rs

safety : ∀ {e e′ A : [] ⊢ tm} →
  ∅ ⊢ e ∶ A → e ↠ e′ → Val e′ ⊎ ∃[ e″ ] (e′ ↪ e″)
safety ⊢e rs = progress (sr* ⊢e rs)

-- ═══ POSITIVE CONTROLS ═══════════════════════════════════════════

-- POSITIVE CONTROL for the metatheory: the typing judgment is inhabited
-- by genuinely DEPENDENT closed terms.  Without this, `sr` and
-- `progress` could be vacuously true.
--
-- Every type below is checked DEFINITIONALLY: in particular
-- `polyid·Nat` requires
--     (Pi (var zero) (var (suc zero))) [ Nat ]₀  ≡  Pi Nat Nat
-- which is the substitution machinery computing under the rewrites.



-- the polymorphic identity, MLTT-style: (X : U) → X → X
polyid : ∅ ⊢ lam U (lam (var zero) (var zero))
           ∶ Pi U (Pi (var zero) (var (suc zero)))
polyid = ⊢lam ⊢U (⊢lam (⊢var refl) (⊢var refl))

-- instantiating it at Nat: the RESULT TYPE is computed by substitution
polyid·Nat : ∅ ⊢ app (lam U (lam (var zero) (var zero))) Nat ∶ Pi Nat Nat
polyid·Nat = ⊢app polyid ⊢Nat

-- and the substitution really did happen, definitionally
instantiation-computed :
  (Pi (var zero) (var (suc zero))) [ Nat ]₀ ≡ Pi {S = []} Nat Nat
instantiation-computed = refl

-- a natrec at the UNIVERSE: the eliminator computing a TYPE
natrec-type : ∅ ⊢ natrec U Nat (var zero) zeroN ∶ U
natrec-type = ⊢natrec ⊢U ⊢Nat (⊢var refl) ⊢zeroN

-- subject reduction applied to it: it ι-reduces to Nat, still at U
natrec-type-sr : ∅ ⊢ Nat ∶ U
natrec-type-sr = sr natrec-type ι-zero

-- progress applied to the redex: it steps
polyid·Nat-steps : ∃[ e′ ] (app (lam U (lam (var zero) (var zero))) Nat ↪ e′)
polyid·Nat-steps with progress polyid·Nat
... | inj₁ ()
... | inj₂ p = p

-- a β-reduction whose reduct is typed by preservation
beta-reduct : ∅ ⊢ lam Nat (var zero) ∶ Pi Nat Nat
beta-reduct = sr polyid·Nat β-app

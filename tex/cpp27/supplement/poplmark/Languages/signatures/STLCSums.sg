-- ═══ The signature of ../STLCSums.agda ══════════════════════
--
-- Generates that module: STLC with disjoint sums, 72 curated rules plus
-- the 15 iterated-lifting rules, 87 in total.
--
-- The one thing the emitter cannot supply is `cong-case`, the
-- three-argument congruence the metatheory of `case` uses: the generator
-- proves its own structural inductions with the generic `cong3`, so the
-- named helper belongs to this core's %%epilogue.

%%module Languages.STLCSums

%%var `_

% infixl 7 _·_

expr : Type

`λx_` : (expr -> expr) -> expr
`_·_` : expr -> expr -> expr
inl   : expr -> expr
inr   : expr -> expr
case  : expr -> (expr -> expr) -> (expr -> expr) -> expr

  lift-dist-compᴿˢ-⨟-var : ∀ {S₄} {ξ : S₁ →ᴿ S₂} {σ : S₂ →ˢ S₃} {τ : (s ∷ S₃) →ˢ S₄} →
    (x [ (ξ ↑ᴿ s) ]ᴿ) [ ((σ ↑ˢ s) ⨟ τ) ]ˢ ≡ x [ (((⟨ ξ ⟩ ⨟ σ) ↑ˢ s) ⨟ τ) ]ˢ

  ⟨⟩-lift-cons : ⟨ ξ ↑ᴿ s ⟩ ⨟ (t ∙ˢ σ) ≡ t ∙ˢ (⟨ ξ ⟩ ⨟ σ)
  ⟨⟩-lift-cons-var : (x [ (ξ ↑ᴿ s) ]ᴿ) [ (t ∙ˢ σ) ]ˢ ≡ x [ (t ∙ˢ (⟨ ξ ⟩ ⨟ σ)) ]ˢ

  ⟨⟩-comp-⨟-lift-wkᴿ  : ∀ {S₄} {ξ : S₁ →ᴿ S₂} {τ : (s ∷ S₂) →ˢ S₄} →
    ⟨ wkᴿ s ⟩ ⨟ (⟨ ξ ↑ᴿ s ⟩ ⨟ τ) ≡ ⟨ ξ ⟩ ⨟ (⟨ wkᴿ s ⟩ ⨟ τ)
  ⟨⟩-comp-⨟-interactᴿ  : ∀ {ξ : S₁ →ᴿ S₂} {x : S₂ ∋ s} {τ : S₂ →ˢ S₃} →
    ⟨ wkᴿ s ⟩ ⨟ (⟨ x ∙ᴿ ξ ⟩ ⨟ τ) ≡ ⟨ ξ ⟩ ⨟ τ
  ⟨⟩-comp-⨟-lift-dist-compᴿᴿ : ∀ {S₄} {ξ₁ : S₁ →ᴿ S₂} {ξ₂ : S₂ →ᴿ S₃} {τ : (s ∷ S₃) →ˢ S₄} →
    ⟨ ξ₁ ↑ᴿ s ⟩ ⨟ (⟨ ξ₂ ↑ᴿ s ⟩ ⨟ τ) ≡ ⟨ (ξ₁ ⨟ᴿ ξ₂) ↑ᴿ s ⟩ ⨟ τ
  ⟨⟩-split-tail : ∀ {S₄} {σ : S₁ →ˢ S₂} {ξ : S₂ →ᴿ S₃} {ξ′ : (s ∷ S₃) →ᴿ S₄} →
    (σ ↑ˢ s) ⨟ ⟨ (ξ ↑ᴿ s) ⨟ᴿ ξ′ ⟩ ≡ ((σ ⨟ ⟨ ξ ⟩) ↑ˢ s) ⨟ ⟨ ξ′ ⟩

  -- ══ the collapse family ══════════════════════════════════════════
  coincidence  : ∀ (t : S ⊢ s) (ξ : S →ᴿ S₂) → t [ ⟨ ξ ⟩ ]ˢ ≡ t [ ξ ]ᴿ
  ⟨⟩-comp      : ⟨ ξ₁ ⟩ ⨟ ⟨ ξ₂ ⟩ ≡ ⟨ ξ₁ ⨟ᴿ ξ₂ ⟩
  ⟨⟩-split-⨟   : ⟨ ξ₁ ⨟ᴿ ξ₂ ⟩ ⨟ σ ≡ ⟨ ξ₁ ⟩ ⨟ (⟨ ξ₂ ⟩ ⨟ σ)
  ⟨⟩-lift      : (⟨ ξ ⟩ ↑ˢ s) ≡ ⟨ ξ ↑ᴿ s ⟩

  -- ══ subsumed: σ⇑'s LiftId is a lemma, not a rule ════════════════
  -- ⟨⟩-lift already sends its LHS to ⟨ idᴿ ↑ᴿ s ⟩, where lift-idᴿ
  -- finishes under the coercion.  A base rule subsumed by its own
  -- coercion image is redundant; it still holds by refl for user code.
  lift-id     : (⟨ idᴿ {S} ⟩ ↑ˢ s) ≡ ⟨ idᴿ ⟩

  -- ══ η: lemmas only ═══════════════════════════════════════════════
  η-idᴿ  : (zero {s = s} {S = S}) ∙ᴿ (wkᴿ s) ≡ idᴿ
  η-lawᴿ : (zero [ ξ ]ᴿ) ∙ᴿ (wkᴿ s ⨟ᴿ ξ) ≡ ξ
  η-id   : (var zero) ∙ˢ (wkˢ s) ≡ idˢ {S = s ∷ S}
  η-law  : (zero [ σ ]ˢ) ∙ˢ (wkˢ s ⨟ σ) ≡ σ
  def-↑ᴿ : ξ ↑ᴿ s ≡ zero ∙ᴿ (ξ ⨟ᴿ wkᴿ s)
  def-↑ˢ  : σ ↑ˢ s ≡ (var zero) ∙ˢ (σ ⨟ wkˢ s)


  -- iterated lifting.  Unlike records, patterns force these to be
  -- REWRITE rules: without lift*-idᴿ the pair (right-idᴿ, instᴿ-let) is
  -- not joinable, because `e₂ [ idᴿ ↑ᴿ*[ b ] n ]ᴿ` is stuck for abstract n.
  lift*-idᴿ         : ∀ b n → (idᴿ {S} ↑ᴿ*[ b ] n) ≡ idᴿ
  lift*-dist-compᴿᴿ : ∀ b n → ((ξ₁ ↑ᴿ*[ b ] n) ⨟ᴿ (ξ₂ ↑ᴿ*[ b ] n)) ≡ ((ξ₁ ⨟ᴿ ξ₂) ↑ᴿ*[ b ] n)
  lift*-dist-compᴿˢ : ∀ b n {ξ : S₁ →ᴿ S₂} {σ : S₂ →ˢ S₃} →
    (⟨ ξ ↑ᴿ*[ b ] n ⟩ ⨟ (σ ↑ˢ*[ b ] n)) ≡ ((⟨ ξ ⟩ ⨟ σ) ↑ˢ*[ b ] n)
  lift*-dist-compˢᴿ : ∀ b n {σ : S₁ →ˢ S₂} {ξ : S₂ →ᴿ S₃} →
    ((σ ↑ˢ*[ b ] n) ⨟ ⟨ ξ ↑ᴿ*[ b ] n ⟩) ≡ ((σ ⨟ ⟨ ξ ⟩) ↑ˢ*[ b ] n)
  lift*-dist-compˢˢ : ∀ b n → ((σ₁ ↑ˢ*[ b ] n) ⨟ (σ₂ ↑ˢ*[ b ] n)) ≡ ((σ₁ ⨟ σ₂) ↑ˢ*[ b ] n)
  ⟨⟩-lift*          : ∀ b n → (⟨ ξ ⟩ ↑ˢ*[ b ] n) ≡ ⟨ ξ ↑ᴿ*[ b ] n ⟩
  -- the iterated completion companions.  One for each `-var` / `-⨟ᴿ` /
  -- `-⨟` companion of the single-lifting layer; each closes exactly the
  -- pair that its single-lifting counterpart closes, one level up.
  lift*-dist-compᴿᴿ-var : ∀ {S₁ S₂ S₃} (b : Sort) (n : ℕ) {s} {x : (ext* b n S₁) ∋ s}
    {ξ₁ : S₁ →ᴿ S₂} {ξ₂ : S₂ →ᴿ S₃} →
    (x [ (ξ₁ ↑ᴿ*[ b ] n) ]ᴿ) [ (ξ₂ ↑ᴿ*[ b ] n) ]ᴿ ≡ x [ ((ξ₁ ⨟ᴿ ξ₂) ↑ᴿ*[ b ] n) ]ᴿ
  lift*-dist-compᴿᴿ-⨟ᴿ : ∀ {S₁ S₂ S₃ S₄} (b : Sort) (n : ℕ) {ξ₁ : S₁ →ᴿ S₂} {ξ₂ : S₂ →ᴿ S₃}
    {ξ′ : (ext* b n S₃) →ᴿ S₄} →
    (ξ₁ ↑ᴿ*[ b ] n) ⨟ᴿ ((ξ₂ ↑ᴿ*[ b ] n) ⨟ᴿ ξ′) ≡ ((ξ₁ ⨟ᴿ ξ₂) ↑ᴿ*[ b ] n) ⨟ᴿ ξ′
  lift*-dist-compˢˢ-⨟ : ∀ {S₁ S₂ S₃} (b : Sort) (n : ℕ) {S₄} {σ₁ : S₁ →ˢ S₂} {σ₂ : S₂ →ˢ S₃}
    {τ : (ext* b n S₃) →ˢ S₄} →
    (σ₁ ↑ˢ*[ b ] n) ⨟ ((σ₂ ↑ˢ*[ b ] n) ⨟ τ) ≡ ((σ₁ ⨟ σ₂) ↑ˢ*[ b ] n) ⨟ τ
  lift*-dist-compᴿˢ-⨟ : ∀ {S₁ S₂ S₃} (b : Sort) (n : ℕ) {S₄} {ξ : S₁ →ᴿ S₂} {σ : S₂ →ˢ S₃}
    {τ : (ext* b n S₃) →ˢ S₄} →
    ⟨ ξ ↑ᴿ*[ b ] n ⟩ ⨟ ((σ ↑ˢ*[ b ] n) ⨟ τ) ≡ ((⟨ ξ ⟩ ⨟ σ) ↑ˢ*[ b ] n) ⨟ τ
  lift*-dist-compˢᴿ-⨟ : ∀ {S₁ S₂ S₃} (b : Sort) (n : ℕ) {S₄} {σ : S₁ →ˢ S₂} {ξ : S₂ →ᴿ S₃}
    {τ : (ext* b n S₃) →ˢ S₄} →
    (σ ↑ˢ*[ b ] n) ⨟ (⟨ ξ ↑ᴿ*[ b ] n ⟩ ⨟ τ) ≡ ((σ ⨟ ⟨ ξ ⟩) ↑ˢ*[ b ] n) ⨟ τ
  lift*-dist-compᴿˢ-var : ∀ {S₁ S₂ S₃} (b : Sort) (n : ℕ) {s} {x : (ext* b n S₁) ∋ s}
    {ξ : S₁ →ᴿ S₂} {σ : S₂ →ˢ S₃} →
    (x [ (ξ ↑ᴿ*[ b ] n) ]ᴿ) [ (σ ↑ˢ*[ b ] n) ]ˢ ≡ x [ ((⟨ ξ ⟩ ⨟ σ) ↑ˢ*[ b ] n) ]ˢ
  ⟨⟩-comp-⨟-lift*-dist-compᴿᴿ : ∀ {S₁ S₂ S₃} (b : Sort) (n : ℕ) {S₄} {ξ₁ : S₁ →ᴿ S₂} {ξ₂ : S₂ →ᴿ S₃}
    {τ : (ext* b n S₃) →ˢ S₄} →
    ⟨ ξ₁ ↑ᴿ*[ b ] n ⟩ ⨟ (⟨ ξ₂ ↑ᴿ*[ b ] n ⟩ ⨟ τ) ≡ ⟨ (ξ₁ ⨟ᴿ ξ₂) ↑ᴿ*[ b ] n ⟩ ⨟ τ
  lift*-dist-compᴿˢ-⨟-var : ∀ {S₁ S₂ S₃} (b : Sort) (n : ℕ) {S₄} {s} {x : (ext* b n S₁) ∋ s}
    {ξ : S₁ →ᴿ S₂} {σ : S₂ →ˢ S₃} {τ : (ext* b n S₃) →ˢ S₄} →
    (x [ (ξ ↑ᴿ*[ b ] n) ]ᴿ) [ ((σ ↑ˢ*[ b ] n) ⨟ τ) ]ˢ ≡ x [ (((⟨ ξ ⟩ ⨟ σ) ↑ˢ*[ b ] n) ⨟ τ) ]ˢ
  ⟨⟩-split*-tail : ∀ {S₁ S₂ S₃} (b : Sort) (n : ℕ) {S₄} {σ : S₁ →ˢ S₂} {ξ : S₂ →ᴿ S₃}
    {ξ′ : (ext* b n S₃) →ᴿ S₄} →
    (σ ↑ˢ*[ b ] n) ⨟ ⟨ (ξ ↑ᴿ*[ b ] n) ⨟ᴿ ξ′ ⟩ ≡ ((σ ⨟ ⟨ ξ ⟩) ↑ˢ*[ b ] n) ⨟ ⟨ ξ′ ⟩
  -- ── proofs ────────────────────────────────────────────────────────

  def-wkᴿ     = refl
  def-∙ᴿ-zero = refl
  def-∙ᴿ-suc  = refl
  def-↑ᴿ-zero = refl
  def-↑ᴿ-suc  = refl

  instᴿ-var = refl
  instᴿ-Pi     = refl
  instᴿ-lam    = refl
  instᴿ-app    = refl
  instᴿ-U      = refl
  instᴿ-Nat    = refl
  instᴿ-zeroN  = refl
  instᴿ-sucN   = refl
  instᴿ-natrec = refl

  assocᴿ {ξ₁ = ξ₁} {ξ₂ = ξ₂} {ξ₃ = ξ₃} = ext λ x → sym (compositionalityᴿᴿ-var (ξ₁ _ x) {ξ₁ = ξ₂} {ξ₂ = ξ₃})
  comp-idₗᴿ = refl
  comp-idᵣᴿ = ext λ x → right-idᴿ _
  distᴿ     = ext λ { zero → refl ; (suc x) → refl }
  interactᴿ = refl

  lift-idᴿ     = ext λ { zero → refl ; (suc x) → refl }
  lift-dist-compᴿᴿ = ext λ { zero → refl ; (suc x) → refl }
  lift-wkᴿ     = refl
  lift-consᴿ   = ext λ { zero → refl ; (suc x) → refl }

  right-idᴿ {m = V} x = refl
  right-idᴿ (var x)   = refl
  right-idᴿ (Pi tm0 tm1)             = cong2 Pi (right-idᴿ tm0) (trans (cong (tm1 [_]ᴿ) lift-idᴿ) (right-idᴿ tm1))
  right-idᴿ (lam tm0 tm1)            = cong2 lam (right-idᴿ tm0) (trans (cong (tm1 [_]ᴿ) lift-idᴿ) (right-idᴿ tm1))
  right-idᴿ (app tm0 tm1)            = cong2 app (right-idᴿ tm0) (right-idᴿ tm1)
  right-idᴿ U                        = refl
  right-idᴿ Nat                      = refl
  right-idᴿ zeroN                    = refl
  right-idᴿ (sucN tm0)               = cong1 sucN (right-idᴿ tm0)
  right-idᴿ (natrec tm0 tm1 tm2 tm3) = cong4 natrec (trans (cong (tm0 [_]ᴿ) lift-idᴿ) (right-idᴿ tm0)) (right-idᴿ tm1) (trans (cong (tm2 [_]ᴿ) (trans (cong (_↑ᴿ tm) lift-idᴿ) lift-idᴿ)) (right-idᴿ tm2)) (right-idᴿ tm3)

  compositionalityᴿᴿ-var x           = refl
  compositionalityᴿᴿ (var x) {ξ₁ = ξ₁} {ξ₂ = ξ₂} = cong var (sym (compositionalityᴿᴿ-var x {ξ₁ = ξ₁} {ξ₂ = ξ₂}))
  compositionalityᴿᴿ (Pi tm0 tm1)                                 = cong2 Pi (compositionalityᴿᴿ tm0) (trans (compositionalityᴿᴿ tm1) (cong (tm1 [_]ᴿ) lift-dist-compᴿᴿ))
  compositionalityᴿᴿ (lam tm0 tm1)                                = cong2 lam (compositionalityᴿᴿ tm0) (trans (compositionalityᴿᴿ tm1) (cong (tm1 [_]ᴿ) lift-dist-compᴿᴿ))
  compositionalityᴿᴿ (app tm0 tm1)                                = cong2 app (compositionalityᴿᴿ tm0) (compositionalityᴿᴿ tm1)
  compositionalityᴿᴿ U                                            = refl
  compositionalityᴿᴿ Nat                                          = refl
  compositionalityᴿᴿ zeroN                                        = refl
  compositionalityᴿᴿ (sucN tm0)                                   = cong1 sucN (compositionalityᴿᴿ tm0)
  compositionalityᴿᴿ (natrec tm0 tm1 tm2 tm3) {ξ₁ = ξ₁} {ξ₂ = ξ₂} = cong4 natrec (trans (compositionalityᴿᴿ tm0) (cong (tm0 [_]ᴿ) lift-dist-compᴿᴿ)) (compositionalityᴿᴿ tm1) (trans (compositionalityᴿᴿ tm2) (cong (tm2 [_]ᴿ) (trans (lift-dist-compᴿᴿ {ξ₁ = (ξ₁ ↑ᴿ tm)} {ξ₂ = (ξ₂ ↑ᴿ tm)}) (cong (_↑ᴿ tm) (lift-dist-compᴿᴿ {ξ₁ = ξ₁} {ξ₂ = ξ₂}))))) (compositionalityᴿᴿ tm3)

  lift-dist-compᴿᴿ-var {x = zero}  = refl
  lift-dist-compᴿᴿ-var {x = suc x} = refl
  lift-consᴿ-var {x = zero}  = refl
  lift-consᴿ-var {x = suc x} = refl
  interactᴿ-⨟ᴿ    = refl
  lift-wkᴿ-⨟ᴿ {s = s} {ξ = ξ} {ξ′ = ξ′} =
    trans (sym (assocᴿ {ξ₁ = wkᴿ s} {ξ₂ = ξ ↑ᴿ s} {ξ₃ = ξ′}))
          (trans (cong (_⨟ᴿ ξ′) (lift-wkᴿ {s = s} {ξ = ξ}))
                 (assocᴿ {ξ₁ = ξ} {ξ₂ = wkᴿ s} {ξ₃ = ξ′}))
  lift-dist-compᴿᴿ-⨟ᴿ {ξ₁ = ξ₁} {ξ₂ = ξ₂} {ξ′ = ξ′} =
    trans (sym (assocᴿ {ξ₁ = ξ₁ ↑ᴿ _} {ξ₂ = ξ₂ ↑ᴿ _} {ξ₃ = ξ′}))
          (cong (_⨟ᴿ ξ′) (lift-dist-compᴿᴿ {ξ₁ = ξ₁} {ξ₂ = ξ₂}))

  coincidence-var = refl
  def-∙ˢ-zero  = refl
  def-∙ˢ-suc   = refl
  def-↑ˢ-zero  = refl
  def-↑ˢ-suc {x = x} {σ = σ} {s = s} = sym (coincidence (σ _ x) (wkᴿ s))
  compositionalityᴿˢ-⨟-var     = refl
  def-↑ˢ-zero-⨟ = refl
  def-↑ˢ-suc-⨟ {x = x} {σ = σ} {s = s} {τ = τ} =
    trans (compositionalityᴿˢ (σ _ x)) (cong ((σ _ x) [_]ˢ) (ext λ y → refl))
  interact  = refl
  comp-idₗ  = refl
  comp-idᵣ {σ = σ} = ext λ y → trans (coincidence (σ _ y) idᴿ) (right-idᴿ (σ _ y))
  lift-wk {s = s} {σ = σ} = ext λ y → sym (coincidence (σ _ y) (wkᴿ s))
  lift-id   = ext λ { zero → refl ; (suc x) → refl }
  lift-wk-⨟ {s = s} {σ = σ} {τ = τ} =
    trans (sym (assoc {σ₁ = ⟨ wkᴿ s ⟩} {σ₂ = σ ↑ˢ s} {σ₃ = τ}))
          (trans (cong (_⨟ τ) (lift-wk {s = s} {σ = σ}))
                 (assoc {σ₁ = σ} {σ₂ = ⟨ wkᴿ s ⟩} {σ₃ = τ}))
  lift-dist-compˢˢ-⨟ {σ₁ = σ₁} {s = s} {σ₂ = σ₂} {τ = τ} =
    trans (sym (assoc {σ₁ = σ₁ ↑ˢ s} {σ₂ = σ₂ ↑ˢ s} {σ₃ = τ}))
          (cong (_⨟ τ) (lift-dist-compˢˢ {σ₁ = σ₁} {s = s} {σ₂ = σ₂}))

  inst-var = refl
  inst-Pi     = refl
  inst-lam    = refl
  inst-app    = refl
  inst-U      = refl
  inst-Nat    = refl
  inst-zeroN  = refl
  inst-sucN   = refl
  inst-natrec = refl

  lift-dist-compᴿˢ : ∀ {ξ : S₁ →ᴿ S₂} {σ : S₂ →ˢ S₃} →
    (⟨ ξ ↑ᴿ s ⟩ ⨟ (σ ↑ˢ s)) ≡ ((⟨ ξ ⟩ ⨟ σ) ↑ˢ s)
  lift-dist-compᴿˢ = ext λ { zero → refl ; (suc x) → refl }

  compositionalityᴿˢ (var x) = refl
  compositionalityᴿˢ (Pi tm0 tm1)                                 = cong2 Pi (compositionalityᴿˢ tm0) (trans (compositionalityᴿˢ tm1) (cong (tm1 [_]ˢ) lift-dist-compᴿˢ))
  compositionalityᴿˢ (lam tm0 tm1)                                = cong2 lam (compositionalityᴿˢ tm0) (trans (compositionalityᴿˢ tm1) (cong (tm1 [_]ˢ) lift-dist-compᴿˢ))
  compositionalityᴿˢ (app tm0 tm1)                                = cong2 app (compositionalityᴿˢ tm0) (compositionalityᴿˢ tm1)
  compositionalityᴿˢ U                                            = refl
  compositionalityᴿˢ Nat                                          = refl
  compositionalityᴿˢ zeroN                                        = refl
  compositionalityᴿˢ (sucN tm0)                                   = cong1 sucN (compositionalityᴿˢ tm0)
  compositionalityᴿˢ (natrec tm0 tm1 tm2 tm3) {ξ₁ = ξ₁} {σ₂ = σ₂} = cong4 natrec (trans (compositionalityᴿˢ tm0) (cong (tm0 [_]ˢ) lift-dist-compᴿˢ)) (compositionalityᴿˢ tm1) (trans (compositionalityᴿˢ tm2) (cong (tm2 [_]ˢ) (trans (lift-dist-compᴿˢ {ξ = (ξ₁ ↑ᴿ tm)} {σ = (σ₂ ↑ˢ tm)}) (cong (_↑ˢ tm) (lift-dist-compᴿˢ {ξ = ξ₁} {σ = σ₂}))))) (compositionalityᴿˢ tm3)

  lift-dist-compˢᴿ : ∀ {σ : S₁ →ˢ S₂} {ξ : S₂ →ᴿ S₃} →
    ((σ ↑ˢ s) ⨟ ⟨ ξ ↑ᴿ s ⟩) ≡ ((σ ⨟ ⟨ ξ ⟩) ↑ˢ s)
  lift-dist-compˢᴿ {s = s} {σ = σ} {ξ = ξ} = ext λ where
    zero    → refl
    (suc x) → let t = σ _ x in
      trans (coincidence (t [ wkᴿ s ]ᴿ) (ξ ↑ᴿ s))
      (trans (compositionalityᴿᴿ t {ξ₁ = wkᴿ s} {ξ₂ = ξ ↑ᴿ s})
      (trans (cong (t [_]ᴿ) (lift-wkᴿ {s = s} {ξ = ξ}))
      (trans (sym (compositionalityᴿᴿ t {ξ₁ = ξ} {ξ₂ = wkᴿ s}))
             (cong (_[ wkᴿ s ]ᴿ) (sym (coincidence t ξ))))))

  compositionalityˢᴿ {m = V} x {σ₁ = σ₁} {ξ₂ = ξ₂} = sym (coincidence (σ₁ _ x) ξ₂)
  compositionalityˢᴿ (var x) {σ₁ = σ₁} {ξ₂ = ξ₂} = sym (coincidence (σ₁ _ x) ξ₂)
  compositionalityˢᴿ (Pi tm0 tm1)                                 = cong2 Pi (compositionalityˢᴿ tm0) (trans (compositionalityˢᴿ tm1) (cong (tm1 [_]ˢ) lift-dist-compˢᴿ))
  compositionalityˢᴿ (lam tm0 tm1)                                = cong2 lam (compositionalityˢᴿ tm0) (trans (compositionalityˢᴿ tm1) (cong (tm1 [_]ˢ) lift-dist-compˢᴿ))
  compositionalityˢᴿ (app tm0 tm1)                                = cong2 app (compositionalityˢᴿ tm0) (compositionalityˢᴿ tm1)
  compositionalityˢᴿ U                                            = refl
  compositionalityˢᴿ Nat                                          = refl
  compositionalityˢᴿ zeroN                                        = refl
  compositionalityˢᴿ (sucN tm0)                                   = cong1 sucN (compositionalityˢᴿ tm0)
  compositionalityˢᴿ (natrec tm0 tm1 tm2 tm3) {σ₁ = σ₁} {ξ₂ = ξ₂} = cong4 natrec (trans (compositionalityˢᴿ tm0) (cong (tm0 [_]ˢ) lift-dist-compˢᴿ)) (compositionalityˢᴿ tm1) (trans (compositionalityˢᴿ tm2) (cong (tm2 [_]ˢ) (trans (lift-dist-compˢᴿ {σ = (σ₁ ↑ˢ tm)} {ξ = (ξ₂ ↑ᴿ tm)}) (cong (_↑ˢ tm) (lift-dist-compˢᴿ {σ = σ₁} {ξ = ξ₂}))))) (compositionalityˢᴿ tm3)

  lift-dist-compˢˢ {σ₁ = σ₁} {s = s} {σ₂ = σ₂} = ext λ where
    zero    → refl
    (suc x) → let t = σ₁ _ x in
      trans (compositionalityᴿˢ t)
      (trans (cong (t [_]ˢ) (ext λ y → sym (coincidence (σ₂ _ y) (wkᴿ s))))
             (sym (compositionalityˢᴿ t)))

  compositionalityˢˢ {m = V} x = refl
  compositionalityˢˢ (var x)   = refl
  compositionalityˢˢ (Pi tm0 tm1)                                 = cong2 Pi (compositionalityˢˢ tm0) (trans (compositionalityˢˢ tm1) (cong (tm1 [_]ˢ) lift-dist-compˢˢ))
  compositionalityˢˢ (lam tm0 tm1)                                = cong2 lam (compositionalityˢˢ tm0) (trans (compositionalityˢˢ tm1) (cong (tm1 [_]ˢ) lift-dist-compˢˢ))
  compositionalityˢˢ (app tm0 tm1)                                = cong2 app (compositionalityˢˢ tm0) (compositionalityˢˢ tm1)
  compositionalityˢˢ U                                            = refl
  compositionalityˢˢ Nat                                          = refl
  compositionalityˢˢ zeroN                                        = refl
  compositionalityˢˢ (sucN tm0)                                   = cong1 sucN (compositionalityˢˢ tm0)
  compositionalityˢˢ (natrec tm0 tm1 tm2 tm3) {σ₁ = σ₁} {σ₂ = σ₂} = cong4 natrec (trans (compositionalityˢˢ tm0) (cong (tm0 [_]ˢ) lift-dist-compˢˢ)) (compositionalityˢˢ tm1) (trans (compositionalityˢˢ tm2) (cong (tm2 [_]ˢ) (trans (lift-dist-compˢˢ {σ₁ = (σ₁ ↑ˢ tm)} {σ₂ = (σ₂ ↑ˢ tm)}) (cong (_↑ˢ tm) (lift-dist-compˢˢ {σ₁ = σ₁} {σ₂ = σ₂}))))) (compositionalityˢˢ tm3)

  assoc {σ₁ = σ₁} {σ₂ = σ₂} {σ₃ = σ₃} = ext λ x → compositionalityˢˢ (σ₁ _ x) {σ₁ = σ₂} {σ₂ = σ₃}
  dist            = ext λ { zero → refl ; (suc x) → refl }
  lift-cons {σ = σ} {t = t} {τ = τ} = ext λ where
    zero    → refl
    (suc x) → trans (compositionalityᴿˢ (σ _ x)) (cong ((σ _ x) [_]ˢ) (ext λ y → refl))

  coincidence (var x) ξ = refl
  coincidence (Pi tm0 tm1) ξ             = cong2 Pi (coincidence tm0 ξ) (trans (cong (tm1 [_]ˢ) (⟨⟩-lift {ξ = ξ})) (coincidence tm1 (ξ ↑ᴿ tm)))
  coincidence (lam tm0 tm1) ξ            = cong2 lam (coincidence tm0 ξ) (trans (cong (tm1 [_]ˢ) (⟨⟩-lift {ξ = ξ})) (coincidence tm1 (ξ ↑ᴿ tm)))
  coincidence (app tm0 tm1) ξ            = cong2 app (coincidence tm0 ξ) (coincidence tm1 ξ)
  coincidence U ξ                        = refl
  coincidence Nat ξ                      = refl
  coincidence zeroN ξ                    = refl
  coincidence (sucN tm0) ξ               = cong1 sucN (coincidence tm0 ξ)
  coincidence (natrec tm0 tm1 tm2 tm3) ξ = cong4 natrec (trans (cong (tm0 [_]ˢ) (⟨⟩-lift {ξ = ξ})) (coincidence tm0 (ξ ↑ᴿ tm))) (coincidence tm1 ξ) (trans (cong (tm2 [_]ˢ) (trans (cong (_↑ˢ tm) (⟨⟩-lift {ξ = ξ})) (⟨⟩-lift {ξ = (ξ ↑ᴿ tm)}))) (coincidence tm2 ((ξ ↑ᴿ tm) ↑ᴿ tm))) (coincidence tm3 ξ)

  lift-dist-compᴿˢ-⨟ {s = s} {ξ = ξ} {σ = σ} {τ = τ} =
    trans (sym (assoc {σ₁ = ⟨ ξ ↑ᴿ s ⟩} {σ₂ = σ ↑ˢ s} {σ₃ = τ}))
          (cong (_⨟ τ) (lift-dist-compᴿˢ {s = s} {ξ = ξ} {σ = σ}))
  lift-dist-compˢᴿ-⨟ {s = s} {σ = σ} {ξ = ξ} {τ = τ} =
    trans (sym (assoc {σ₁ = σ ↑ˢ s} {σ₂ = ⟨ ξ ↑ᴿ s ⟩} {σ₃ = τ}))
          (cong (_⨟ τ) (lift-dist-compˢᴿ {s = s} {σ = σ} {ξ = ξ}))
  lift-dist-compᴿˢ-var {x = zero}  = refl
  lift-dist-compᴿˢ-var {x = suc x} = refl
  lift-dist-compᴿˢ-⨟-var {x = zero}  = refl
  lift-dist-compᴿˢ-⨟-var {x = suc x} = refl
  ⟨⟩-comp-⨟-lift-wkᴿ    = ext λ x → refl
  ⟨⟩-comp-⨟-interactᴿ    = ext λ x → refl
  ⟨⟩-comp-⨟-lift-dist-compᴿᴿ  = ext λ { zero → refl ; (suc x) → refl }
  ⟨⟩-split-tail {s = s} {σ = σ} {ξ = ξ} {ξ′ = ξ′} = ext λ where
    zero    → refl

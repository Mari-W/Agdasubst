  (suc y) [ x ∙ᴿ ξ ]ᴿ = y [ ξ ]ᴿ
  (var x) [ ξ ]ᴿ = var (x [ ξ ]ᴿ)
  (Pi tm0 tm1)             [ ξ ]ᴿ = Pi (tm0 [ ξ ]ᴿ) (tm1 [ ξ ↑ᴿ tm ]ᴿ)
  (lam tm0 tm1)            [ ξ ]ᴿ = lam (tm0 [ ξ ]ᴿ) (tm1 [ ξ ↑ᴿ tm ]ᴿ)
  (app tm0 tm1)            [ ξ ]ᴿ = app (tm0 [ ξ ]ᴿ) (tm1 [ ξ ]ᴿ)
  U                        [ ξ ]ᴿ = U
  Nat                      [ ξ ]ᴿ = Nat
  zeroN                    [ ξ ]ᴿ = zeroN
  (sucN tm0)               [ ξ ]ᴿ = sucN (tm0 [ ξ ]ᴿ)
  (natrec tm0 tm1 tm2 tm3) [ ξ ]ᴿ = natrec (tm0 [ ξ ↑ᴿ tm ]ᴿ) (tm1 [ ξ ]ᴿ) (tm2 [ (ξ ↑ᴿ tm) ↑ᴿ tm ]ᴿ) (tm3 [ ξ ]ᴿ)

